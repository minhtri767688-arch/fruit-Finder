-- 1. Lấy server qua __ServerBrowser Remote (ngầm) - Quét từ trang 35 đến 90 nơi chứa server dưới 10 người
local function getServersViaRemoteSilent()
    local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
    if not sb then return nil end

    local curJob = game.JobId
    local validServers = {}
    local startPage = math.random(55, 80)

    for page = startPage, 100 do
        local ok, res = pcall(function()
            return sb:InvokeServer(page)
        end)

        if ok and type(res) == "table" and next(res) ~= nil then
            for jobId, data in pairs(res) do
                local id = tostring(jobId)
                local playing = 0
                local maxP = 12

                if type(data) == "table" then
                    playing = tonumber(data.Count or data.count or data.Players or data.playing or 0) or 0
                    maxP = tonumber(data.MaxPlayers or data.maxPlayers or 12) or 12
                elseif type(data) == "number" then
                    playing = data
                end

                -- KHÓA CỨNG: BẮT BUỘC TỪ 4 ĐẾN 8 NGƯỜI (DƯỚI 10 NGƯỜI)
                if id ~= "" and id ~= curJob and playing >= CONFIG.MinPlayers and playing <= CONFIG.MaxPlayers and playing < 10 and playing < maxP then
                    local ct = HopCache[id]
                    if not ct or (tick() - ct > 300) then
                        table.insert(validServers, {id = id, playing = playing, maxP = maxP})
                    end
                end
            end
            if #validServers >= 8 then break end
        end
        task.wait(0.1)
    end

    return #validServers > 0 and validServers or nil
end

-- 2. Lấy server qua Roblox Public API (ngầm)
local function httpGet(url)
    for _, m in ipairs({
        function() if syn and syn.request then return syn.request({Url=url,Method="GET"}).Body end end,
        function() if http_request then return http_request({Url=url,Method="GET"}).Body end end,
        function() if request then return request({Url=url,Method="GET"}).Body end end,
        function() if fluxus and fluxus.request then return fluxus.request({Url=url,Method="GET"}).Body end end,
        function() return game:HttpGet(url) end,
    }) do
        local ok, v = pcall(m)
        if ok and v and #tostring(v) > 10 then return v end
    end
    return nil
end

local function getServersViaAPISilent()
    local url = "https://games.roblox.com/v1/games/" .. PlaceID
        .. "/servers/Public?sortOrder=Asc&limit=100"
    local raw = httpGet(url)
    if not raw then return nil end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok or not data or not data.data then return nil end

    local out = {}
    local curJob = game.JobId
    for _, s in ipairs(data.data) do
        local id      = tostring(s.id or s.jobId or "")
        local playing = tonumber(s.playing) or 0
        local maxP    = tonumber(s.maxPlayers) or 12
        local ct      = HopCache[id]
        if id ~= "" and id ~= curJob
            and (not ct or tick() - ct > 300)
            and playing >= CONFIG.MinPlayers
            and playing <= CONFIG.MaxPlayers
            and playing < maxP
        then
            table.insert(out, {id = id, playing = playing, maxP = maxP})
        end
    end
    return #out > 0 and out or nil
end

