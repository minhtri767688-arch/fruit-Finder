-- 🍎 HÀM THU THẬP QUẢ SIÊU TỐC (BUG FLY 0.35s -> STOP FLY NGAY LẬP TỨC -> HÚT QUẢ)
-- Tuyệt đối KHÔNG bay ra đảo, KHÔNG reset health/tự tử!
-- ====================================================================
local function smartTakeAndStoreFruit(fruitData)
    if not fruitData or not fruitData.Object then
        restoreCharacterMovement()
        return "no"
    end

    local targetPart = fruitData.RootPart or getFruitRoot(fruitData.Object)
    if not targetPart then
        restoreCharacterMovement()
        return "no"
    end

    local fruitPos = targetPart.Position
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        restoreCharacterMovement()
        return "no"
    end

    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")

    -- Thử tối đa 3 lần theo đúng cơ chế Bug Fly -> Dừng tức thì -> Hút quả
    for attempt = 1, 3 do
        if not fruitData.Object or fruitData.Object.Parent ~= Workspace then
            break
        end

        fruitPos = (targetPart and targetPart.Parent and targetPart.Position) or fruitPos

        -- 1. BUG FLY: Lao 0.35s về hướng quả
        startNoClip()
        local okTween, tw = pcall(function()
            return TweenService:Create(hrp, TweenInfo.new(0.35, Enum.EasingStyle.Linear), { CFrame = CFrame.new(fruitPos + Vector3.new(0, 2, 0)) })
        end)
        if okTween and tw then
            tw:Play()
            task.wait(0.35)
            tw:Cancel() -- Dừng bay NGAY LẬP TỨC!
        end
        stopNoClip()
        restoreCharacterMovement()

        -- 2. HÚT QUẢ: Kéo quả về trước mặt nhân vật & kích hoạt Touch / Equip
        for _ = 1, 5 do
            pcall(function()
                if targetPart and targetPart:IsA("BasePart") then
                    targetPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -1.5)
                    targetPart.AssemblyLinearVelocity = Vector3.zero
                    targetPart.AssemblyAngularVelocity = Vector3.zero
                end
                if fruitData.Object:IsA("Tool") and fruitData.Object:FindFirstChild("Handle") then
                    fruitData.Object.Handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -1.5)
                    fruitData.Object.Handle.AssemblyLinearVelocity = Vector3.zero
                end
            end)

            if firetouchinterest then
                pcall(function() firetouchinterest(hrp, targetPart, 0) end)
            end

            if fruitData.Object:IsA("Tool") and hum then
                pcall(function() hum:EquipTool(fruitData.Object) end)
            end
            task.wait(0.06)
        end

        if firetouchinterest then
            pcall(function() firetouchinterest(hrp, targetPart, 1) end)
        end

        task.wait(0.2)
        storeAllInventoryFruits()

        -- Kiểm tra xem quả đã vào túi chưa (hoặc đã được cất)
        local isCollected = (fruitData.Object.Parent == LocalPlayer.Backpack) or
                            (LocalPlayer.Character and fruitData.Object.Parent == LocalPlayer.Character) or
                            (not fruitData.Object.Parent or fruitData.Object.Parent ~= Workspace)
        if isCollected then
            local storeRes = tryStoreSingleFruit(fruitData)
            storeAllInventoryFruits()
            restoreCharacterMovement()
            return storeRes
        end

        task.wait(0.15)
    end

    local finalStore = "no"
    local isDone = (not fruitData.Object or not fruitData.Object.Parent or fruitData.Object.Parent ~= Workspace)
    if isDone then
        finalStore = tryStoreSingleFruit(fruitData)
        storeAllInventoryFruits()
    end

    restoreCharacterMovement()
    return finalStore
end

