-- Trích xuất chính xác số người chơi từ chuỗi Text (Hỗ trợ định dạng: "Players: 8/12", "Players: 8", "8/12", "9/12")
local function extractPlayerCountFromText(str)
    if not str or type(str) ~= "string" then return nil end
    local s = str:gsub("%s+", " ")

    -- Mẫu 1: "Players: 8/12" hoặc "players: 9/12"
    local p1 = s:match("[Pp]layers:%s*(%d+)%s*/%s*(%d+)")
    if p1 then return tonumber(p1) end

    -- Mẫu 2: "Players: 8" hoặc "players: 9"
    local p2 = s:match("[Pp]layers:%s*(%d+)")
    if p2 then return tonumber(p2) end

    -- Mẫu 3: "8/12" hoặc "9/12" (số người tối đa chuẩn là 10-16)
    local curP, maxP = s:match("(%d+)%s*/%s*(%d+)")
    if curP and maxP then
        local mNum = tonumber(maxP)
        if mNum and mNum >= 10 and mNum <= 16 then
            return tonumber(curP)
        end
    end

    return nil
end

-- Lấy số người chơi chính xác của DUY NHẤT một hàng chứa nút Join (không quét lẫn sang hàng khác)
local function getPlayerCountForJoinButton(btn, browserFrame)
    if not btn then return nil end

    -- Cách 1: Quét trực tiếp trong btn.Parent (Container hàng)
    if btn.Parent then
        for _, lbl in ipairs(btn.Parent:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" then
                local count = extractPlayerCountFromText(lbl.Text)
                if count then return count end
            end
        end
    end

    -- Cách 2: Quét trong btn.Parent.Parent (nếu nút được bọc trong subframe)
    if btn.Parent and btn.Parent.Parent and not btn.Parent.Parent:IsA("ScreenGui") and not btn.Parent.Parent:IsA("ScrollingFrame") then
        for _, lbl in ipairs(btn.Parent.Parent:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" then
                local count = extractPlayerCountFromText(lbl.Text)
                if count then return count end
            end
        end
    end

    -- Cách 3: So khớp tọa độ Y (Nằm cùng hàng ngang trong vòng 35 pixels)
    if btn.AbsolutePosition and browserFrame then
        local btnY = btn.AbsolutePosition.Y
        for _, lbl in ipairs(browserFrame:GetDescendants()) do
            if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" and lbl.AbsolutePosition then
                if math.abs(lbl.AbsolutePosition.Y - btnY) <= 35 then
                    local count = extractPlayerCountFromText(lbl.Text)
                    if count then return count end
                end
            end
        end
    end

    return nil
end

-- Tìm JobId từ hàng server nếu có thuộc tính hoặc Name GUID
local function findJobIdFromRow(btn)
    if not btn then return nil end
    local objs = { btn, btn.Parent, btn.Parent and btn.Parent.Parent }
    for _, obj in ipairs(objs) do
        if obj then
            local attrId = obj:GetAttribute("JobId") or obj:GetAttribute("ServerId") or obj:GetAttribute("id")
            if attrId and type(attrId) == "string" and #attrId > 15 then
                return attrId
            end
            if obj.Name and obj.Name:match("^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$") then
                return obj.Name
            end
            local sv = obj:FindFirstChild("JobId") or obj:FindFirstChild("ServerId")
            if sv and sv:IsA("StringValue") and #sv.Value > 15 then
                return sv.Value
            end
        end
    end
    return nil
end

