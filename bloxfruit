end

local function getIslandForPosition(targetPos)
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    if not worldOrigin or not worldOrigin:FindFirstChild("Locations") then return nil, 999999 end

    local nearestLoc = nil
    local minDistance = 999999

    for _, loc in ipairs(worldOrigin.Locations:GetChildren()) do
        local locPos = loc:IsA("BasePart") and loc.Position or loc:GetPivot().Position
        local dist = (Vector3.new(targetPos.X, 0, targetPos.Z) - Vector3.new(locPos.X, 0, locPos.Z)).Magnitude
        if dist < minDistance then
            minDistance = dist
            nearestLoc = loc
        end
    end

    return nearestLoc, minDistance
end

