local function BypassTP(Target)
    local Character = LocalPlayer.Character
    if not Character then return false end
    
    local Humanoid = WaitForHumanoid()
    if not Humanoid or Humanoid.Health <= 0 then return false end
    
    if CanBypassTeleport(Target) then
        local TargetTP = GetBypassCFrame(Target)
        if TargetTP and TargetTP:FindFirstChild("Part") then
            print(string.format("[AutoFruit] 🚀 Kích hoạt Bypass TP sang đảo: %s...", TargetTP.Name))
            setHUDStatus("bypass tp: " .. TargetTP.Name)

            -- 1. Dừng tween và OnFarm trước khi reset
            shouldTween = false
            getgenv().OnFarm = false
            if activeTween then
                pcall(function() activeTween:Cancel() end)
                activeTween = nil
            end

            -- 2. Đồng bộ CFrame của block tới điểm spawn trên đảo đích ngay lập tức
            if block then
                block.CFrame = TargetTP.Part.CFrame
            end

            -- 3. Tắt LastSpawnPoint script để chống game tự ghi đè đảo cũ (chuẩn 100% script.lua dòng 1871)
            pcall(function()
                if Character:FindFirstChild("LastSpawnPoint") then
                    Character.LastSpawnPoint.Disabled = true
                end
            end)

            -- 4. Đặt spawn point đảo mới qua Remote CommF_ (chuẩn 100% script.lua dòng 1872-1873)
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("SetLastSpawnPoint", TargetTP.Name)
            end)
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("SetSpawnPoint")
            end)

            -- 5. Pivot tức thì đến điểm spawn đảo đích và reset (ChangeState 15 chuẩn 100% script.lua dòng 1874-1875)
            Character:PivotTo(TargetTP.Part.CFrame)
            pcall(function()
                Humanoid:ChangeState(15)
            end)
            pcall(function()
                Humanoid.Health = 0
            end)
            
            -- 6. Chờ nhân vật hồi sinh mượt mà trên đảo đích (chuẩn 100% script.lua dòng 1877-1879)
            local t0 = tick()
            repeat 
                task.wait(0.05) 
            until (LocalPlayer.Character and WaitForHumanoid() and WaitForHumanoid().Health > 0) or (tick() - t0 > 7)
            
            task.wait(0.5)

            local newChar = LocalPlayer.Character
            local newPart = newChar and (newChar.PrimaryPart or newChar:FindFirstChild("HumanoidRootPart"))
            if newPart and block then
                block.CFrame = newPart.CFrame
            end
            print(string.format("[AutoFruit] ✅ Đã hồi sinh thành công trên đảo %s! Sẵn sàng bay lấy quả.", TargetTP.Name))
            return true
        end
    end
    return false
end

