                        for id, data in pairs(res) do
                            local sId = tostring(id)
                            local plrs = 0
                            local maxP = 12
                            if type(data) == "table" then
                                plrs = tonumber(data.Count or data.count or data.Players or data.playing or 0) or 0
                                maxP = tonumber(data.MaxPlayers or data.maxPlayers or 12) or 12
                            elseif type(data) == "number" then
                                plrs = data
                            end

                            -- LỌC CỨNG NGAY TẠI NGUỒN: CHỈ NHẬN TỪ 4 ĐẾN 9 NGƯỜI
                            if sId ~= "" and sId ~= game.JobId and plrs >= 4 and plrs <= 9 and plrs < maxP then
                                local ct = HopCache[sId]
                                if not ct or (tick() - ct > 120) then
                                    table.insert(candidates, {id = sId, playing = plrs, maxP = maxP})
                                end
                            end
                        end
                    end
                    if #candidates >= 10 then break end
                    task.wait(0.08)
                end
            end
        end)

        -- Bổ sung server từ API nếu cần (API cũng đã lọc MinPlayers = 4, MaxPlayers = 9)
        if #candidates < 6 then
            local apiServers = getServersViaAPISilent()
            if apiServers then
                for _, s in ipairs(apiServers) do
                    if s.playing >= 4 and s.playing <= 9 then
                        table.insert(candidates, s)
                    end
                end
            end
        end

        -- Lọc và sắp xếp: Chỉ lấy server từ 4 đến 9 người
        local viable = {}
        for _, s in ipairs(candidates) do
            if s.playing >= 4 and s.playing <= 9 and s.playing < s.maxP then
                local ct = HopCache[s.id]
                if not ct or (tick() - ct > 120) then
                    table.insert(viable, s)
                end
            end
        end

        -- Sắp xếp ít người nhất lên đầu (4 -> 9 người)
        table.sort(viable, function(a, b)
            return a.playing < b.playing
        end)

        if #viable > 0 then
            print(string.format("[AutoHop] Tìm thấy %d server khả dụng (4 - 9 người). Bắt đầu kết nối...", #viable))
            for i = 1, math.min(#viable, 6) do
                local srv = viable[i]
                print(string.format("[AutoHop] Đang hop vào server %d/%d (%d/%d người)...", i, #viable, srv.playing, srv.maxP))
                local ok = teleportToJobId(srv.id, srv.playing, srv.maxP)
                if not ok then
                    dismissRobloxErrorPrompt()
                end
            end
        else
            print("[AutoHop] Chưa tìm thấy server 4-9 người nào khả dụng, làm mới cache và quét lại...")
            HopCache = { [game.JobId] = tick() }
            getgenv().BFHopCache = HopCache
        end

        task.wait(CONFIG.HopInterval)
        dismissRobloxErrorPrompt()
    end
end

