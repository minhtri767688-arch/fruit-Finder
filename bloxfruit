local processedFruitTools = {}

local function tryStoreSingleFruit(fruitData, explicitTool)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    if not commF then return "no" end

    -- Ưu tiên Tool được truyền trực tiếp từ bước nhặt của chính quả này
    local fruitTool = explicitTool or (fruitData and fruitData.CollectedTool)

    -- Nếu chưa có, tìm Tool mới trong Backpack/Character chưa từng được xử lý
    if not fruitTool or not fruitTool.Parent then
        local targetKey = fruitData and fruitData.Info and fruitData.Info.Key
        if LocalPlayer:FindFirstChild("Backpack") then
            for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if item:IsA("Tool") and not processedFruitTools[item] then
                    local iname = string.lower(item.Name)
                    local origAttr = item:GetAttribute("OriginalName")
                    if targetKey and (string.find(iname, targetKey) or (origAttr and string.find(string.lower(tostring(origAttr)), targetKey))) then
                        fruitTool = item
                        break
                    elseif string.find(iname, "fruit") or item:FindFirstChild("EatRemote") then
                        fruitTool = item
                        break
                    end
                end
            end
        end
        if not fruitTool and LocalPlayer.Character then
            for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                if item:IsA("Tool") and not processedFruitTools[item] then
                    local iname = string.lower(item.Name)
                    local origAttr = item:GetAttribute("OriginalName")
                    if targetKey and (string.find(iname, targetKey) or (origAttr and string.find(string.lower(tostring(origAttr)), targetKey))) then
                        fruitTool = item
                        break
                    elseif string.find(iname, "fruit") or item:FindFirstChild("EatRemote") then
                        fruitTool = item
                        break
                    end
                end
            end
        end
    end

    local origName = nil
    if fruitTool then
        origName = fruitTool:GetAttribute("OriginalName") or fruitTool.Name
        processedFruitTools[fruitTool] = true
    elseif fruitData and fruitData.Info then
        origName = fruitData.Info.DisplayName or fruitData.Info.Key
    end

    if not fruitTool then
        local ok, res = pcall(function()
            return commF:InvokeServer("StoreFruit", origName)
        end)
        return (ok and res == true) and "yes" or "no"
    end

    -- Gọi InvokeServer cất quả
    local callOk, res = pcall(function()
        return commF:InvokeServer("StoreFruit", origName, fruitTool)
    end)
    task.wait(0.35)

    -- Kiểm tra nếu tool không còn trong Backpack hoặc Character -> Đã cất thành công ("yes")
    local stillInInventory = false
    pcall(function()
        if fruitTool and fruitTool.Parent then
            if fruitTool.Parent == LocalPlayer.Backpack or (LocalPlayer.Character and fruitTool.Parent == LocalPlayer.Character) then
                stillInInventory = true
            end
        end
    end)

    if not stillInInventory or (callOk and res == true) then
        return "yes"
    else
        return "no"
    end
end

