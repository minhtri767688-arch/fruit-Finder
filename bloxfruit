-- 🧠 HỆ THỐNG NHẬN DẠNG TRÁI SIÊU CHÍNH XÁC (SCAN LÀ BIẾT NGAY TÊN TRÁI TRƯỚC KHI NHẶT)
-- Quét từ thuộc tính OriginalName, FruitName, Part Name, Mesh, Texture, Decal, Particles...
-- ====================================================================
local function identifyFruit(obj)
    if not obj then return nil end

    local candidates = {}
    local seen = {}

    -- Danh sách các từ khóa rác trong cấu trúc Roblox/Tool tuyệt đối không nhận diện thành trái
    local badWords = {
        "controller", "animation", "humanoid", "camera", "billboard", "touch",
        "screen", "frame", "emitter", "sound", "weld", "mesh", "part", "texture",
        "particle", "attachment", "highlight", "esp", "click", "prompt", "joint",
        "handle", "basepart", "meshpart", "specialmesh", "model", "folder", "value"
    }

    local function addCandidate(val)
        if not val then return end
        if type(val) == "string" and val ~= "" then
            local trimmed = string.gsub(val, "^%s*(.-)%s*$", "%1")
            local lowerTrimmed = string.lower(trimmed)
            if trimmed ~= "" and not seen[trimmed] then
                -- Kiểm tra xem chuỗi có chứa từ khóa rác không (trừ phi chuỗi đó chứa từ 'fruit')
                local isGarbage = false
                if not lowerTrimmed:find("fruit") and not FruitOriginalNameMap[lowerTrimmed] and not FruitDatabase[lowerTrimmed] then
                    for _, bad in ipairs(badWords) do
                        if lowerTrimmed:find(bad, 1, true) then
                            isGarbage = true
                            break
                        end
                    end
                end

                if not isGarbage then
                    seen[trimmed] = true
                    table.insert(candidates, trimmed)
                end
            end
        end
    end

    -- 1. ƯU TIÊN 1: Lấy các thuộc tính định danh chính thức của Blox Fruits
    pcall(function()
        addCandidate(obj:GetAttribute("OriginalName"))
        addCandidate(obj:GetAttribute("FruitName"))
        addCandidate(obj:GetAttribute("Fruit"))
        addCandidate(obj:GetAttribute("ItemName"))
        addCandidate(obj:GetAttribute("DisplayName"))
        if obj.Name and obj.Name ~= "Fruit " and obj.Name ~= "Fruit" and obj.Name ~= "Blox Fruit" and obj.Name ~= "Devil Fruit" then
            addCandidate(obj.Name)
        end
        if obj:IsA("Tool") and obj.ToolTip and obj.ToolTip ~= "" and obj.ToolTip ~= "Blox Fruit" then
            addCandidate(obj.ToolTip)
        end
    end)

    -- 2. ƯU TIÊN 2: Quét Handle và EatRemote
    pcall(function()
        local h = obj:FindFirstChild("Handle")
        if h then
            addCandidate(h:GetAttribute("OriginalName"))
            addCandidate(h:GetAttribute("FruitName"))
            addCandidate(h:GetAttribute("Fruit"))
            addCandidate(h:GetAttribute("ItemName"))
            if h.Name and h.Name ~= "Handle" then
                addCandidate(h.Name)
            end
        end
        local eatRemote = obj:FindFirstChild("EatRemote", true)
        if eatRemote and eatRemote.Parent then
            addCandidate(eatRemote.Parent:GetAttribute("OriginalName"))
            addCandidate(eatRemote.Parent:GetAttribute("FruitName"))
            if eatRemote.Parent.Name and eatRemote.Parent.Name ~= "Handle" and eatRemote.Parent.Name ~= "Fruit " and eatRemote.Parent.Name ~= "Fruit" then
                addCandidate(eatRemote.Parent.Name)
            end
        end
        -- Quét toàn bộ children để lấy tên trái (chuẩn Star Hub: ví dụ mesh part Kitsune bên trong model Fruit )
        for _, child in ipairs(obj:GetChildren()) do
            if child.Name and child.Name ~= "Handle" and not string.find(child.Name, "ESP") then
                addCandidate(child.Name)
                addCandidate(child:GetAttribute("OriginalName"))
                addCandidate(child:GetAttribute("FruitName"))
            end
        end
    end)

    -- 3. HÀM ĐỐI SOÁT TỪNG CANDIDATE VỚI DATABASE TRÁI ÁC QUỶ (CHUẨN XÁC 100%, CHỐNG MATCH NHẦM CONTROLLER -> CONTROL)
    local function matchString(str)
        if not str or str == "" then return nil end
        local raw = string.lower(str):gsub("^%s*(.-)%s*$", "%1")
        local clean = raw:gsub("%s+", ""):gsub("[%-_]", "")

        -- A. Khớp chính xác trong FruitOriginalNameMap (ví dụ: "control-control", "rocket-rocket")
        local mapped = FruitOriginalNameMap[raw] or FruitOriginalNameMap[clean]
        if mapped and FruitDatabase[mapped] then
            local data = FruitDatabase[mapped]
            return {
                Key = mapped,
                DisplayName = data.Display .. " Fruit",
                Rarity = data.Rarity,
                Color = data.Color,
            }
        end

        -- B. Khớp chính xác clean name trong FruitDatabase
        if FruitDatabase[clean] then
            local data = FruitDatabase[clean]
            return {
                Key = clean,
                DisplayName = data.Display .. " Fruit",
                Rarity = data.Rarity,
                Color = data.Color,
            }
        end

        -- C. Xóa tiền tố/hậu tố "fruit", "blox"
        local stripped = raw:gsub("fruit", ""):gsub("blox", ""):gsub("[%-_%s]+", "")
        if stripped ~= "" then
            local mStrip = FruitOriginalNameMap[stripped] or (FruitDatabase[stripped] and stripped)
            if mStrip and FruitDatabase[mStrip] then
                local data = FruitDatabase[mStrip]
                return {
                    Key = mStrip,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end

        -- D. Khớp theo SortedFruitKeys: BẮT BUỘC MATCH TỪ ĐỘC LẬP (WORD BOUNDARY) HOẶC LẶP TÊN
        for _, key in ipairs(SortedFruitKeys) do
            local cleanKey = key:gsub("[%-_]", "")
            -- 1. Lặp đôi tên đặc trưng Blox Fruits: rocketrocket, controlcontrol, kitsunekitsune
            if clean == (cleanKey .. cleanKey) or clean == (cleanKey .. "fruit") or clean == ("fruit" .. cleanKey) then
                local data = FruitDatabase[key]
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end

            -- 2. Khớp theo word boundary: từ đứng độc lập có khoảng trắng, gạch nối hoặc đầu/cuối chuỗi
            -- TUYỆT ĐỐI KHÔNG MATCH KHI LÀ CHUỖI CON CỦA "controller" HOẶC "animationcontroller"
            if raw == key or raw:find("%f[%a]" .. key .. "%f[%A]") or raw:find("^" .. key .. "[%-_%s]") or raw:find("[%-_%s]" .. key .. "$") then
                local data = FruitDatabase[key]
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end

        return nil
    end

    -- Duyệt qua toàn bộ danh sách candidates
    for _, candidate in ipairs(candidates) do
        local result = matchString(candidate)
        if result then
            return result
        end
    end

    -- 4. FALLBACK: Khi quả là Model/Tool tên "Fruit " hoặc "Devil Fruit" tự nhiên dưới gốc cây chưa có metadata
    local rawObjName = string.lower(string.gsub(obj.Name or "", "^%s*(.-)%s*$", "%1"))
    if rawObjName == "fruit " or rawObjName == "fruit" or rawObjName == "devil fruit" or rawObjName == "blox fruit" or string.find(rawObjName, "fruit") then
        return {
            Key = "fruit",
            DisplayName = "Devil Fruit",
            Rarity = "Rare",
            Color = Color3.fromRGB(255, 90, 90),
        }
    end

    return {
        Key = "unknown",
        DisplayName = "unknown",
        Rarity = "unknown",
        Color = Color3.fromRGB(255, 95, 95),
    }
end

