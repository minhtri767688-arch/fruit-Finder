-- ====================================================================
-- ✈️ AUTO TWEEN TO FRUIT / _TP CHUẨN 100% SCRIPT.LUA (Dòng 1969-2038)
-- Kết hợp BypassTP đảo xa + requestentrance + Tween 300 studs/s + BodyClip & Noclip
-- ====================================================================
local function _tp(target)
    local gg = Convert_CFrame(target)
    if not gg then return false end

    -- An toàn biển: Tự động nâng Y tối thiểu >= 18 studs để tuyệt đối không rơi/chìm xuống nước biển
    if gg.Y < 18 then
        gg = CFrame.new(gg.X, 18, gg.Z)
    end
    
    local character = LocalPlayer.Character
    if not character or not (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")) then return false end
    local rootPart = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
    
    -- 1. Nếu ở đảo xa (>= 2500 studs): Kích hoạt BypassTP sang đảo đích (chuẩn script.lua dòng 1986)
    pcall(function()
        if CanBypassTeleport(gg) then
            BypassTP(gg)
            task.wait(0.5)
        end
    end)
    
    -- 2. Chuyển map / cổng nếu cần thiết (requestentrance chuẩn script.lua dòng 1993)
    pcall(function()
        requestentrance(gg)
    end)
    
    -- Lấy lại character & rootPart mới sau khi hồi sinh trên đảo đích
    character = LocalPlayer.Character or character
    rootPart = character and (character.PrimaryPart or character:FindFirstChild("HumanoidRootPart"))
    if not rootPart then return false end
    
    local distance = (gg.Position - rootPart.Position).Magnitude
    if distance < 4 then
        if block then block.CFrame = gg end
        return true
    end

    -- Bắt đầu tween cực mượt tới quả (tốc độ chuẩn 300 studs/s từ script.lua dòng 2019)
    block.CFrame = rootPart.CFrame
    shouldTween = true
    getgenv().OnFarm = true
    
    local tweenDuration = math.max(distance / 300, 0.08)
    local tweenInfo = TweenInfo.new(tweenDuration, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(block, tweenInfo, { CFrame = gg })    
    activeTween = tween
    
    local hum = character:FindFirstChildOfClass("Humanoid")
    if hum and hum.Sit == true then
        hum.Sit = false
        block.CFrame = CFrame.new(block.Position.X, gg.Y, block.Position.Z)
    end  
    
    tween:Play()    
    
    local startTime = tick()
    while tween.PlaybackState == Enum.PlaybackState.Playing and shouldTween do 
        local curChar = LocalPlayer.Character
        local curHrp = curChar and (curChar.PrimaryPart or curChar:FindFirstChild("HumanoidRootPart"))
        if curHrp then
            local d = (curHrp.Position - gg.Position).Magnitude
            -- Hút trái từ khoảng cách 30 studs trước khi tới nơi (chuẩn script.lua dòng 1563)
            if d <= 30 then
                collectFruits(true)
            end
            if d <= 3 then
                break
            end
        end
        if (tick() - startTime) > (tweenDuration + 1.2) then
            break
        end
        task.wait(0.04) 
    end 
    
    pcall(function() tween:Cancel() end)
    activeTween = nil
    if block then block.CFrame = gg end
    
    return true
end

local function tweenToFruit(targetCF, customSpeed)
