                if t == "join" or t:find("join") then isJoin = true end
            elseif item:IsA("ImageButton") then
                local n = (item.Name or ""):lower()
                if n == "join" or n:find("join") then isJoin = true end
            end

            if isJoin then
                local parent = item.Parent
                local playing = 0
                local maxP = 12
                if parent then
                    for _, lbl in ipairs(parent:GetDescendants()) do
                        if lbl:IsA("TextLabel") and lbl.Text then
                            local cur, mx = lbl.Text:match("(%d+)%s*/%s*(%d+)")
                            if cur then
                                playing = tonumber(cur) or 0
                                maxP = tonumber(mx) or 12
                                break
                            end
                        end
                    end
                end

                if playing < 12 then
                    table.insert(joinButtons, { btn = item, playing = playing, maxP = maxP })
                end
            end
        end
    end

    if #joinButtons == 0 then
        return false
    end

    -- Sắp xếp: Ưu tiên server ít người hơn trước (4-9 người) để tránh bị lỗi 772 Server is full
    table.sort(joinButtons, function(a, b)
        if a.playing > 0 and b.playing > 0 then
            return a.playing < b.playing
        end
        return a.playing > 0
    end)

    print(string.format("[AutoHop] Tìm thấy %d nút Join trong Browser! Bắt đầu spam join...", #joinButtons))

    -- Spam click lần lượt từng nút Join
    for i, entry in ipairs(joinButtons) do
        local btn = entry.btn
        if btn and btn.Parent then
            print(string.format("[AutoHop] Spam Join nút %d/%d (%d/%d người)...", i, #joinButtons, entry.playing, entry.maxP))

            -- Auto-load script khi sang server mới
            pcall(function()
                local q = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
                if q and isfile and isfile("bloxfruitautofruit.lua") then
                    q('task.wait(2); loadfile("bloxfruitautofruit.lua")()')
                end
            end)

            -- Click nút Join bằng mọi cách
            pcall(function()
                if firesignal then
                    firesignal(btn.MouseButton1Click)
                    firesignal(btn.MouseButton1Down)
                    firesignal(btn.MouseButton1Up)
                    firesignal(btn.Activated)
                end
                if getconnections then
                    for _, ev in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
                        local ok, conns = pcall(getconnections, btn[ev])
                        if ok and conns then
                            for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
                        end
                    end
                end
                pcall(function()
                    local vim = game:GetService("VirtualInputManager")
                    if vim and btn.AbsolutePosition and btn.AbsoluteSize then
                        local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
                        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                        vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                    end
                end)
                btn:Activate()
            end)

            -- Kiểm tra ngay: Nếu hiện popup 772 -> Bấm OK ngay và chuyển sang nút tiếp theo!
            local gotError = false
            for _ = 1, 5 do
                task.wait(0.08)
                if dismissRobloxErrorPrompt() then
                    gotError = true
                    print("[AutoHop] Phát hiện lỗi 772 -> Đã tự bấm OK, chuyển ngay sang server tiếp theo!")
                    break
                end
            end

            -- Nếu không dính lỗi 772 ngay, đợi 1.2s xem có chuyển map không
            if not gotError then
                task.wait(1.2)
                if dismissRobloxErrorPrompt() then
                    print("[AutoHop] Lỗi xuất hiện trễ -> Đã bấm OK, tiếp tục spam!")
                end
            end
        end
    end

    return true
end

-- 4. Teleport theo JobId (kết hợp cả __ServerBrowser Remote lẫn TeleportService)
local function teleportToJobId(id, playing, maxP)
    HopCache[id] = tick()

    -- Chuẩn bị tự chạy lại script ở server mới
    pcall(function()
        local q = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
        if q and isfile and isfile("bloxfruitautofruit.lua") then
            q('task.wait(2); loadfile("bloxfruitautofruit.lua")()')
        end
    end)

    -- Cách A: Gọi trực tiếp Remote của Blox Fruits
    pcall(function()
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if sb then
            sb:InvokeServer("teleport", id)
        end
    end)

    -- Cách B: Gọi TeleportService
    pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceID, id, LocalPlayer)
    end)

    -- Watchdog 1.2s: nếu hiện 772 / 773, lập tức bấm OK và trả về false để chuyển server khác ngay
    for _ = 1, 8 do
        task.wait(0.15)
        if dismissRobloxErrorPrompt() then
            print("[AutoHop] Server " .. tostring(id):sub(1, 10) .. " bị lỗi 772/Full! Đã bấm OK, chuyển server ngay!")
            return false
        end
    end

    return true
end

-- Hàm thực thi Server Hop siêu tốc (Spam liên tục, không bao giờ bị dừng)
local function executeServerHop()
    setHUDStatus("hoping server")
    setHUDFruit(nil)

    while true do
        -- ƯU TIÊN 1: Spam click từng nút Join trong Server Browser in-game
        local browserOk = spamJoinInGameBrowser()
        if browserOk then
            task.wait(1.2)
            dismissRobloxErrorPrompt()
        end

        -- ƯU TIÊN 2: Quét server qua API và Remote để spam teleport trực tiếp
        local candidates = {}

        local apiServers = getServersViaAPISilent()
        if apiServers then
            for _, s in ipairs(apiServers) do table.insert(candidates, s) end
        end

        local remoteServers = getServersViaRemoteSilent()
        if remoteServers then
            for _, s in ipairs(remoteServers) do table.insert(candidates, s) end
        end

        -- Lọc và sắp xếp: Ưu tiên server có 2 - 10 người (tránh server 11-12 người bị full 772)
        local viable = {}
        for _, s in ipairs(candidates) do
            if s.playing >= CONFIG.MinPlayers and s.playing <= CONFIG.MaxPlayers and s.playing < s.maxP then
                local ct = HopCache[s.id]
                if not ct or (tick() - ct > 120) then
                    table.insert(viable, s)
                end
            end
        end

        -- Sắp xếp ít người nhất lên đầu
        table.sort(viable, function(a, b) return a.playing < b.playing end)

        if #viable > 0 then
            print(string.format("[AutoHop] Tìm thấy %d server khả dụng từ API/Remote. Bắt đầu spam teleport...", #viable))
            for i, srv in ipairs(viable) do
                print(string.format("[AutoHop] Đang hop vào server %d/%d (%d/%d người)...", i, #viable, srv.playing, srv.maxP))
                local ok = teleportToJobId(srv.id, srv.playing, srv.maxP)
                if not ok then
                    -- Bị 772 và đã bấm OK -> Lập tức thử server tiếp theo
                    dismissRobloxErrorPrompt()
                end
            end
        else
            -- Đã thử hết cache -> Xóa cache và bắt đầu lại
            HopCache = { [game.JobId] = tick() }
            getgenv().BFHopCache = HopCache
        end

        task.wait(CONFIG.HopInterval)
    end
end

