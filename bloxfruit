local function ChooseTeamAction(teamName)
    teamName = teamName or "Pirates"
    pcall(function()
        if LocalPlayer and (not LocalPlayer.Team or LocalPlayer.Team.Name == "" or LocalPlayer.Team.Name == "Neutral") then
            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
            local commF = remotes and remotes:FindFirstChild("CommF_")
            if commF then
                commF:InvokeServer("SetTeam", teamName)
            end

            pcall(function()
                local pg = LocalPlayer:FindFirstChild("PlayerGui")
                local chooseGui = pg and pg:FindFirstChild("Main") and pg.Main:FindFirstChild("ChooseTeam")
                if chooseGui then
                    local button = chooseGui:FindFirstChild("Container") and chooseGui.Container:FindFirstChild(teamName)
                    if button then
                        for _, v in pairs(button:GetDescendants()) do
                            if v:IsA("TextButton") or v:IsA("ImageButton") then
                                for _, btnEvent in pairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
                                    if firesignal then
                                        pcall(function() firesignal(v[btnEvent]) end)
                                    end
                                    if getconnections then
                                        local ok, conns = pcall(getconnections, v[btnEvent])
                                        if ok and conns then
                                            for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
                                        end
                                    end
                                end
                                pcall(function() v:Activate() end)
                            end
                        end
                    end
                    chooseGui.Visible = false
                end
            end)
        end
    end)
end

