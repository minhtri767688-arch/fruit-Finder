end)

local function identifyFruit(obj)
    if not obj then return nil end

    -- 1. ƯU TIÊN CAO NHẤT: Thuộc tính OriginalName từ game (Chính xác 100%, ví dụ: "Rocket-Rocket", "T-Rex-T-Rex")
    local origName = nil
    pcall(function()
        origName = obj:GetAttribute("OriginalName")
        if not origName and obj:FindFirstChild("Handle") then
            origName = obj.Handle:GetAttribute("OriginalName")
        end
        if not origName then
            local eatRem = obj:FindFirstChild("EatRemote", true)
            if eatRem and eatRem.Parent then
                origName = eatRem.Parent:GetAttribute("OriginalName")
            end
        end
    end)

    if origName and type(origName) == "string" and origName ~= "" then
        local rawKey = string.lower(origName):gsub("%s+", "")
        local mapped = FruitOriginalNameMap[rawKey]
        if mapped and FruitDatabase[mapped] then
            local data = FruitDatabase[mapped]
            return {
                Key = mapped,
                DisplayName = data.Display .. " Fruit",
                Rarity = data.Rarity,
                Color = data.Color,
            }
        end

        for _, key in ipairs(SortedFruitKeys) do
            if rawKey:find(key, 1, true) then
                local data = FruitDatabase[key]
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end
    end

    -- 2. ƯU TIÊN 2: Tên của chính đối tượng obj.Name (nếu không phải tên chung chung)
    local rawName = string.lower(tostring(obj.Name or ""))
    local cleanName = rawName:gsub("%s+", "")

    if FruitOriginalNameMap[cleanName] then
        local mapped = FruitOriginalNameMap[cleanName]
        local data = FruitDatabase[mapped]
        return {
            Key = mapped,
            DisplayName = data.Display .. " Fruit",
            Rarity = data.Rarity,
            Color = data.Color,
        }
    end

    if rawName ~= "fruit " and rawName ~= "fruit" and rawName ~= "blox fruit" and rawName ~= "devil fruit" then
        for _, key in ipairs(SortedFruitKeys) do
            if rawName:find("%f[%a]" .. key .. "%f[%A]") or rawName:find(key, 1, true) then
                local data = FruitDatabase[key]
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end
    end

    -- 3. ƯU TIÊN 3: ToolTip của Tool
    if obj:IsA("Tool") and obj.ToolTip and obj.ToolTip ~= "" and obj.ToolTip ~= "Blox Fruit" then
        local tip = string.lower(obj.ToolTip)
        for _, key in ipairs(SortedFruitKeys) do
            if tip:find("%f[%a]" .. key .. "%f[%A]") or tip:find(key, 1, true) then
                local data = FruitDatabase[key]
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end
    end

    -- 4. TRÁI HOANG DÃ CHƯA LOAD ĐỦ TÊN (Spawn tên "Fruit " hoặc "Devil Fruit"):
    -- Hiển thị đúng là "Devil Fruit [Unknown]", TUYỆT ĐỐI KHÔNG match bừa thành Control hay Dragon!
    return {
        Key = "devilfruit",
        DisplayName = "Devil Fruit",
        Rarity = "Unknown",
        Color = Color3.fromRGB(255, 60, 60),
    }
end

