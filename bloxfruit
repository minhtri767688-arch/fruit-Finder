        end

        if #foundFruits > 0 then
            -- CÓ TRÁI TRONG SERVER: THU THẬP TẤT CẢ CÁC TRÁI
            for i, fruit in ipairs(foundFruits) do
                setHUDFruit(fruit.Info)
                setHUDStatus("taking fruit")

                -- Thu thập quả (kết hợp bay + reset đảo nếu ở xa)
                smartTakeAndStoreFruit(fruit)
                task.wait(0.5)
                storeAllInventoryFruits()
            end

            -- Quét kiểm tra lại lần 2 xem còn trái nào khác không
            task.wait(0.5)
            local remaining = scanAllFruits()
            if #remaining > 0 then
                for _, fruit in ipairs(remaining) do
                    setHUDFruit(fruit.Info)
                    setHUDStatus("taking fruit")

                    smartTakeAndStoreFruit(fruit)
                    task.wait(0.5)
                    storeAllInventoryFruits()
                end
            end

            -- Đã nhặt và cất hết trái trong server -> Hop sang server khác
            setHUDFruit(nil)
            setHUDStatus("hoping server")
            executeServerHop()
            break
        else
            -- SERVER KHÔNG CÓ TRÁI NÀO -> TỰ ĐỘNG HOP SERVER NGAY
            setHUDFruit(nil)
            setHUDStatus("hoping server")
            executeServerHop()
            break
        end
    end
