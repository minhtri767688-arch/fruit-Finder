                    if getconnections then
                        for _, c in ipairs(getconnections(btn.MouseButton1Click) or {}) do pcall(function() c:Fire() end) end
                    end
                    pcall(function() btn:Activate() end)
                    break
                end
            end
        end
    end)

    task.wait(0.4)
    dismissRobloxErrorPrompt()

    -- Quét tất cả các nút Join
    local joinButtons = {}
    local searchedGuis = {pg}
    if CoreGui then table.insert(searchedGuis, CoreGui) end

    for _, root in ipairs(searchedGuis) do
        for _, item in ipairs(root:GetDescendants()) do
