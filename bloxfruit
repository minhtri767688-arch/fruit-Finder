local function isFruitObject(obj)
    if not obj or not obj.Parent then return false end
    local name = string.lower(obj.Name)

    for _, bad in ipairs(BlacklistedTerms) do
        if string.find(name, bad) then return false end
    end

    if obj:IsA("Tool") then
        local handle = obj:FindFirstChild("Handle")
        if not handle then return false end
        if obj.Parent and obj.Parent:FindFirstChildOfClass("Humanoid") and obj.Parent ~= LocalPlayer.Character then
            return false
        end
        if string.find(name, "fruit") or obj.ToolTip == "Blox Fruit" or obj:FindFirstChild("EatRemote") or obj:GetAttribute("OriginalName") then
            return true
        end
        for key, _ in pairs(FruitDatabase) do
            if string.find(name, key) then return true end
        end
    end

    if obj:IsA("Model") or obj:IsA("BasePart") then
        if obj:GetAttribute("OriginalName") then return true end
        if string.find(name, "fruit") then
            local handle = obj:FindFirstChild("Handle") or (obj:IsA("BasePart") and obj) or obj.PrimaryPart
            if handle and handle:IsA("BasePart") then return true end
        end
    end

    return false
end

local function identifyFruit(obj)
    if not obj then return nil end
    local candidates = {}
    if obj.Name then table.insert(candidates, tostring(obj.Name)) end

    pcall(function()
        local orig = obj:GetAttribute("OriginalName") or obj:GetAttribute("FruitName") or obj:GetAttribute("Fruit")
        if orig then table.insert(candidates, tostring(orig)) end
    end)

    for _, child in ipairs(obj:GetChildren()) do
        if child.Name and child.Name ~= "Handle" and child.Name ~= "TouchInterest" and not string.find(child.Name, "ESP") then
            table.insert(candidates, tostring(child.Name))
        end
        pcall(function()
            local childOrig = child:GetAttribute("OriginalName") or child:GetAttribute("FruitName")
            if childOrig then table.insert(candidates, tostring(childOrig)) end
        end)
    end

    for _, candidate in ipairs(candidates) do
        local str = string.lower(candidate)
        str = string.gsub(str, "fruit", "")
        str = string.gsub(str, "blox", "")
        str = string.gsub(str, "%-.*", "")
        str = string.gsub(str, "%s+", "")

        for key, data in pairs(FruitDatabase) do
            if string.find(str, key) or string.find(string.lower(candidate), key) then
                return {
                    Key = key,
                    DisplayName = data.Display .. " Fruit",
                    Rarity = data.Rarity,
                    Color = data.Color,
                }
            end
        end
    end

    local rawName = string.gsub(obj.Name, "^%s*(.-)%s*$", "%1")
    if string.lower(rawName) == "fruit" or string.lower(rawName) == "fruit " then
        return {
            Key = "fruit",
            DisplayName = "Devil Fruit",
            Rarity = "Rare",
            Color = Color3.fromRGB(40, 160, 255),
        }
    end

    return {
        Key = string.lower(rawName),
        DisplayName = rawName,
        Rarity = "Common",
        Color = Color3.fromRGB(200, 200, 200),
    }
end

local function getFruitRoot(obj)
    if not obj then return nil end
    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
        return obj.Handle
    elseif obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

local IgnoredFolders = {
    ["Terrain"] = true, ["Camera"] = true, ["Characters"] = true,
    ["NPCs"] = true, ["Enemies"] = true, ["Map"] = true,
    ["Buildings"] = true, ["Sea"] = true, ["Ocean"] = true,
    ["Water"] = true, ["Islands"] = true, ["_WorldOrigin"] = true,
    ["Effects"] = true, ["Particles"] = true, ["Spawns"] = true,
    ["Lighting"] = true, ["Sound"] = true
}

local function scanAllFruits()
    local fruits = {}
    local added = {}

    local function checkAndAdd(obj)
        if not obj or added[obj] then return end
        if isFruitObject(obj) then
            local root = getFruitRoot(obj)
            if root and root:IsA("BasePart") then
                added[obj] = true
                local info = identifyFruit(obj)
                table.insert(fruits, {
                    Object = obj,
                    RootPart = root,
                    Info = info,
                    Name = info.DisplayName,
                    Rarity = info.Rarity,
                })
            end
        end
    end

    for _, child in ipairs(Workspace:GetChildren()) do
        if not IgnoredFolders[child.Name] then
            checkAndAdd(child)
        end
    end

    for _, folderName in ipairs({"Fruit", "Drops", "Fruits", "Chest"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                checkAndAdd(child)
            end
        end
    end

    return fruits
end

