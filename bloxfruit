local function smartTakeAndStoreFruit(fruitData)
    if not fruitData or not fruitData.Object then
        return "no"
    end

    local targetPart = fruitData.RootPart or fruitData.Handle or getFruitRoot(fruitData.Object)
    if not targetPart then
        return "no"
    end

    local fruitPos = targetPart.Position
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        local t0 = tick()
        repeat
            task.wait(0.1)
            char = LocalPlayer.Character
        until (char and char:FindFirstChild("HumanoidRootPart")) or (tick() - t0 > 5)
    end
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        return "retry"
    end

    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    local startDist = (hrp.Position - fruitPos).Magnitude

    print(string.format("[AutoFruit] 🍎 Auto Tween to Fruit: %s [%s] (Khoảng cách: %.1f studs)...", fruitData.Name or "unknown", fruitData.Rarity or "unknown", startDist))
    setHUDStatus("collect fruit")
    setHUDFruit(fruitData.Info)

    -- 1. Tween tới gần quả bằng _tp chuẩn Star Hub
    _tp(targetPart.CFrame)

    -- Chờ tween bay đến cự ly Settings.CollectDistance (10 studs) hoặc hoàn thành
    local maxWait = math.clamp(startDist / Settings.TweenSpeed + 4, 3, 35)
    local tWait = tick()
    while shouldTween and currentTween and (tick() - tWait < maxWait) do
        char = plr.Character
        hrp = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
        if not hrp or not targetPart.Parent then break end
        local d = (targetPart.Position - hrp.Position).Magnitude
        if d <= Settings.CollectDistance then
            break
        end
        task.wait(0.08)
    end

    char = plr.Character or char
    hrp = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart")) or hrp
    hum = char and char:FindFirstChildOfClass("Humanoid") or hum

    -- 2. Khi đã trong cự ly CollectDistance: Đưa root của quả chạm vào character (chuẩn Star Hub gốc)
    if char and hrp and targetPart and targetPart.Parent then
        pcall(function()
            targetPart.CFrame = hrp.CFrame
        end)
    end

    -- Dừng tween ngay sau khi đã tiếp cận quả
    stopTween()

    if firetouchinterest and targetPart and targetPart.Parent and hrp then
        pcall(function()
            firetouchinterest(hrp, targetPart, 0)
            task.wait(0.01)
            firetouchinterest(hrp, targetPart, 1)
        end)
    end

    -- 3. Chờ tối đa 1.5 giây để quả vào Backpack hoặc Character
    local collectedFruitTool = nil
    local tCheck = tick()
    while (tick() - tCheck < 1.5) do
        if LocalPlayer:FindFirstChild("Backpack") then
            for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if item:FindFirstChild("EatRemote", true) or string.find(string.lower(item.Name), "fruit") then
                    collectedFruitTool = item
                    break
                end
            end
        end
        if not collectedFruitTool and LocalPlayer.Character then
            for _, item in ipairs(LocalPlayer.Character:GetChildren()) do
                if item:FindFirstChild("EatRemote", true) or (item:IsA("Tool") and string.find(string.lower(item.Name), "fruit")) then
                    collectedFruitTool = item
                    break
                end
            end
        end

        if collectedFruitTool then break end

        if hrp and targetPart and targetPart.Parent then
            pcall(function() targetPart.CFrame = hrp.CFrame end)
            if firetouchinterest then
                pcall(function()
                    firetouchinterest(hrp, targetPart, 0)
                    task.wait(0.01)
                    firetouchinterest(hrp, targetPart, 1)
                end)
            end
        end
        task.wait(0.08)
    end

    -- 4. Cất sạch trái vào kho (UpdStFruit chuẩn 100% Star Hub script.lua)
    UpdStFruit()

    -- 5. GIẢI PHÓNG TRẠNG THÁI BAY VÀ TWEEN NGAY LẬP TỨC: NHÂN VẬT HẠ ĐẤT BÌNH THƯỜNG, HẾT T-POSE!
    shouldTween = false
    getgenv().OnFarm = false
    restoreCharacterMovement()

    -- 3. XÁC ĐỊNH TÊN TRÁI THẬT TỪ TOOL VỪA NHẶT (CHÍNH XÁC 100%, FIX TRIỆT ĐỂ LỖI DEVIL FRUIT)
    if collectedFruitTool then
        fruitData.CollectedTool = collectedFruitTool
        local realInfo = identifyFruit(collectedFruitTool)
        if realInfo and realInfo.DisplayName ~= "unknown" and realInfo.DisplayName ~= "Devil Fruit" then
            fruitData.Info = realInfo
            fruitData.Name = realInfo.DisplayName
            fruitData.Rarity = realInfo.Rarity
            setHUDFruit(realInfo)
            print(string.format("[AutoFruit] ✅ ĐÃ NHẶT THÀNH CÔNG: %s [%s]!", realInfo.DisplayName, realInfo.Rarity))
        end

        -- 4. STORE LIỀN THẬT NHANH RỒI MỚI QUA TRÁI TIẾP THEO (UpdStFruit chuẩn 100% script.lua)
        print(string.format("[AutoFruit] 📦 Đang cất ngay %s vào kho lưu trữ...", fruitData.Name or "Fruit"))
        local commF = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")
        local storeRes = "no"

        if commF then
            local eatRemote = collectedFruitTool:FindFirstChild("EatRemote", true)
            local origName = (eatRemote and eatRemote.Parent and eatRemote.Parent:GetAttribute("OriginalName")) 
                             or collectedFruitTool:GetAttribute("OriginalName") 
                             or collectedFruitTool.Name
            local ok, res = pcall(function()
                return commF:InvokeServer("StoreFruit", origName, collectedFruitTool)
            end)
            if ok then
                if res == true then
                    storeRes = "yes"
                elseif type(res) == "string" and string.find(string.lower(res), "store 1") then
                    storeRes = "full"
                end
            end

            -- Cất sạch bằng UpdStFruit chuẩn 100% script.lua dòng 1554
            local extraStored = UpdStFruit()
            if extraStored then storeRes = "yes" end
        end

        if not collectedFruitTool.Parent or (collectedFruitTool.Parent ~= LocalPlayer.Backpack and collectedFruitTool.Parent ~= LocalPlayer.Character) then
            storeRes = "yes"
        end

        -- Nếu kho đầy hoặc đã có trái này trong kho (Max 1) và tool vẫn trong túi/tay:
        if storeRes ~= "yes" and (collectedFruitTool.Parent == LocalPlayer.Backpack or collectedFruitTool.Parent == LocalPlayer.Character) then
            storeRes = "full"
            print(string.format("[AutoFruit] ⚠️ Kho đầy hoặc đã có sẵn trái %s trong rương lưu trữ (Max 1). Đã nhặt nhưng không thể cất!", fruitData.Name or "Fruit"))
            if hum then
                pcall(function() hum:UnequipTools() end)
            end
        end

        -- Đánh dấu trái đã thu thập thành công
        ProcessedFruits[fruitData.Object] = true
        ProcessedFruits[collectedFruitTool] = true

        fruitData.StoreResult = storeRes
        print(string.format("[AutoFruit] Hoàn tất cất kho: %s | Kết quả cất: %s", fruitData.Name or "Fruit", storeRes))

        -- 5. XÓA ESP & HIGHLIGHT CHO TRÁI NÀY (Đã thu thập xong)
        removeFruitESP(fruitData.Object)
        removeFruitESP(collectedFruitTool)

        -- 6. GỬI DISCORD WEBHOOK CHO TRÁI NÀY
        notifyFruitWebhook(fruitData, storeRes)

        return storeRes
    else
        -- Kiểm tra xem quả có còn trong Workspace không
        local stillExists = false
        pcall(function()
            if fruitData.Object and fruitData.Object.Parent and (fruitData.Object.Parent == Workspace or fruitData.Object:IsDescendantOf(Workspace)) then
                stillExists = true
            end
        end)

        if stillExists then
            -- TUYỆT ĐỐI KHÔNG ĐÁNH DẤU PROCESSED KHI QUẢ VẪN CÒN TRONG MAP!
            print(string.format("[AutoFruit] ⚠️ Chưa nhặt được %s nhưng quả vẫn còn trong map! Sẽ tiếp tục thử lại...", fruitData.Name or "Fruit"))
            return "retry"
        else
            -- Quả đã biến mất khỏi Workspace (ai đó nhặt hoặc despawn)
            print(string.format("[AutoFruit] ⚠️ Quả %s đã biến mất khỏi Workspace.", fruitData.Name or "Fruit"))
            ProcessedFruits[fruitData.Object] = true
            removeFruitESP(fruitData.Object)
            return "no"
        end
    end
end

