local function getFruitRoot(obj)
    if not obj then return nil end
    if obj:IsA("Tool") and obj:FindFirstChild("Handle") then
        return obj.Handle
    elseif obj:IsA("Model") then
        return obj.PrimaryPart or obj:FindFirstChild("Handle") or obj:FindFirstChildOfClass("BasePart")
    elseif obj:IsA("BasePart") then
        return obj
    end
    return nil
end

local FruitOriginalNameMap = nil -- Forward declaration

local function isFruitObject(obj)
    if not obj or not obj.Parent then return false end
    if ProcessedFruits[obj] then return false end

    -- 1. TUYỆT ĐỐI KHÔNG NHẬN DIỆN NPC, BOSS, MOBS, HOẶC PLAYER
    if obj:FindFirstChildOfClass("Humanoid") then return false end
    if obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") then return false end
    if obj:FindFirstChildOfClass("AnimationController") then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end

    -- 2. TUYỆT ĐỐI KHÔNG NHẬN DIỆN VẬT PHẨM TRONG CHARACTER/BACKPACK CỦA BẤT KỲ NGƯỜI CHƠI NÀO
    if obj.Parent and (obj.Parent:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(obj.Parent)) then return false end
    if obj.Parent == LocalPlayer:FindFirstChild("Backpack") then return false end
    if obj:FindFirstAncestorWhichIsA("Backpack") then return false end
    if obj:FindFirstAncestorWhichIsA("Player") then return false end
    if obj:FindFirstAncestorOfClass("Model") and obj:FindFirstAncestorOfClass("Model"):FindFirstChildOfClass("Humanoid") then return false end

    local name = string.lower(obj.Name)

    -- 3. LOẠI BỎ TOÀN BỘ VẬT PHẨM NẰM TRONG BLACKLIST (Star Hub blacklist + Blox Fruits props)
    for _, bad in ipairs(BlacklistedTerms) do
        if string.find(name, bad) then return false end
    end

    -- 4. BẮT BUỘC PHẢI CÓ ROOT PART HỢP LỆ VÀ KÍCH THƯỚC NHỎ (<= 10 studs)
    -- Trái ác quỷ chỉ là vật phẩm nhỏ cầm tay (1-4 studs). Mọi công trình map, sàn, tường, bàn thờ > 10 studs -> LOẠI BỎ 100%!
    local root = getFruitRoot(obj)
    if not root or not root:IsA("BasePart") then return false end
    if root.Size.Magnitude > 10 then return false end

    -- BƯỚC A: NẾU LÀ TOOL (Rơi trên đất trong Workspace hoặc drop từ kho)
    if obj:IsA("Tool") then
        if obj:FindFirstChild("EatRemote", true) then return true end
        if obj:GetAttribute("OriginalName") or root:GetAttribute("OriginalName") then return true end
        if obj:GetAttribute("FruitName") or root:GetAttribute("FruitName") then return true end
        if obj.ToolTip == "Blox Fruit" then return true end
        if (FruitOriginalNameMap and FruitOriginalNameMap[name]) or FruitDatabase[name] then return true end
        for key in pairs(FruitDatabase) do
            if name:find("%f[%a]" .. key .. "%f[%A]") then return true end
        end
        if string.find(name, "fruit") then return true end
    end

    -- BƯỚC B: NẾU LÀ MODEL TRÁI TỰ NHIÊN SPAWN TRÊN ĐẤT (WILD SPAWNED FRUIT DƯỚI GỐC CÂY)
    if obj:IsA("Model") then
        if obj:FindFirstChild("EatRemote", true) then return true end
        if obj:GetAttribute("OriginalName") or root:GetAttribute("OriginalName") or obj:GetAttribute("FruitName") or root:GetAttribute("FruitName") then
            return true
        end
        if (name == "fruit " or name == "fruit" or name == "blox fruit" or name == "devil fruit") then
            return true
        end
        if (FruitOriginalNameMap and FruitOriginalNameMap[name]) or FruitDatabase[name] then
            return true
        end
        for key in pairs(FruitDatabase) do
            if name:find("%f[%a]" .. key .. "%f[%A]") then
                return true
            end
        end
        -- Kiểm tra tên các child bên trong Model (chuẩn Star Hub)
        for _, child in ipairs(obj:GetChildren()) do
            local cName = string.lower(child.Name)
            if (FruitOriginalNameMap and FruitOriginalNameMap[cName]) or FruitDatabase[cName] or child:GetAttribute("OriginalName") or child:GetAttribute("FruitName") then
                return true
            end
        end
        if string.find(name, "fruit") and (root:FindFirstChild("TouchInterest") or obj:FindFirstChild("TouchInterest", true) or obj.Parent == Workspace or (obj.Parent and (obj.Parent.Name == "Fruit" or obj.Parent.Name == "Fruits" or obj.Parent.Name == "Drops" or obj.Parent.Name == "SpawnedFruits"))) then
            return true
        end
    end

    -- BƯỚC C: NẾU LÀ BASEPART (Trái ác quỷ xuất hiện dưới dạng BasePart độc lập)
    if obj:IsA("BasePart") then
        if obj:GetAttribute("OriginalName") or obj:GetAttribute("FruitName") then return true end
        if (name == "fruit " or name == "fruit" or name == "blox fruit" or name == "devil fruit") then return true end
        if (FruitOriginalNameMap and FruitOriginalNameMap[name]) or FruitDatabase[name] then return true end
        for key in pairs(FruitDatabase) do
            if name:find("%f[%a]" .. key .. "%f[%A]") then return true end
        end
        if string.find(name, "fruit") and obj:FindFirstChild("TouchInterest") then return true end
    end

    return false
end

