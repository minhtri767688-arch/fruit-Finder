local function CanBypassTeleport(x)
    if CheckLegendaryItems() then return false end
    if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("LastSpawnPoint") and LocalPlayer.Data.LastSpawnPoint.Value == "SubmergedIsland" then 
        return false 
    end
    if GetDistance(x) <= 2500 then
        return false
    end
    local area = InArea(x)
    local AreaName = area.Name or ""
    if AreaName ~= "" then
        if AreaName:find("Dimension") or AreaName:find("Submerged") or AreaName == "Sealed Cavern" or AreaName:lower():find("under") then
            return false
        end
    end
    return true
end

local function GetBypassCFrame(x)
    local Max = math.huge
    local Pos = nil
    local wo = Workspace:FindFirstChild("_WorldOrigin")
    local ps = wo and wo:FindFirstChild("PlayerSpawns")
    if not ps then return nil end
    local Spawns = (ps:FindFirstChild("Pirates") and tostring(LocalPlayer.Team) ~= "Marines") and ps.Pirates or (ps:FindFirstChild("Marines") or ps:GetChildren()[1])
    if not Spawns then return nil end
    local HRP = LocalPlayer.Character and (LocalPlayer.Character.PrimaryPart or LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
    if not HRP then return nil end
    local targetPos = Convert_CFrame(x)
    if not targetPos then return nil end
    targetPos = targetPos.Position
    
    for _, v in pairs(Spawns:GetChildren()) do
        if v:FindFirstChild("Part") then
            if (targetPos - HRP.Position).Magnitude >= 2500 
            and GetSpawnPoint(v.Part) ~= GetSpawnPoint(HRP) 
            and (v.Part.Position - HRP.Position).Magnitude <= 15000 
            and (v.Part.Position - targetPos).Magnitude <= Max then
                Max = (v.Part.Position - targetPos).Magnitude
                Pos = v
            end
        end
    end
    return Pos
end

