-- Hàm click nút GUI cực mạnh (kết hợp cả firesignal, getconnections, VirtualInputManager, VirtualUser, Activate)
local function clickButtonReliably(btn)
    if not btn then return false end

    -- 1. Cuộn nút vào tầm nhìn của ScrollingFrame (nếu nằm trong container cuộn)
    pcall(function()
        local sf = btn:FindFirstAncestorOfClass("ScrollingFrame")
        if sf and btn.AbsolutePosition and sf.AbsolutePosition then
            local diff = btn.AbsolutePosition.Y - sf.AbsolutePosition.Y
            if diff < 0 or diff > sf.AbsoluteSize.Y then
                sf.CanvasPosition = Vector2.new(0, math.max(0, sf.CanvasPosition.Y + diff - 40))
            end
        end
    end)
    task.wait(0.04)

    local pos = Vector2.zero
    pcall(function()
        if btn.AbsolutePosition and btn.AbsoluteSize then
            pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        end
    end)

    -- 2. firesignal độc lập từng sự kiện
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        pcall(function() firesignal(btn.MouseButton1Down) end)
        pcall(function() firesignal(btn.MouseButton1Up) end)
    end

    -- 3. getconnections độc lập từng sự kiện
    if getconnections then
        for _, ev in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
            pcall(function()
                local ok, conns = pcall(getconnections, btn[ev])
                if ok and conns then
                    for _, c in ipairs(conns) do
                        pcall(function() c:Fire() end)
                    end
                end
            end)
        end
    end

    -- 4. VirtualInputManager (Mô phỏng click chuột phần cứng)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim and pos.X > 0 and pos.Y > 0 then
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.02)
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end
    end)

    -- 5. VirtualUser (Mô phỏng click cho cả mobile/mac executors)
    pcall(function()
        local vu = game:GetService("VirtualUser")
        if vu and pos.X > 0 and pos.Y > 0 then
            vu:ClickButton1(pos)
        end
    end)

    -- 6. btn:Activate()
    pcall(function() btn:Activate() end)

    return true
end

-- Tìm nút mở Server Browser THẬT trên giao diện (Đặc biệt là góc trên bên phải ở Sea 2 và Sea 3)
local function findServerBrowserButton()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end

    local cam = workspace.CurrentCamera
    local viewSize = cam and cam.ViewportSize or Vector2.new(800, 600)

    -- 1. Tìm theo tên trực tiếp trong PlayerGui
    for _, btn in ipairs(pg:GetDescendants()) do
        if btn:IsA("ImageButton") or btn:IsA("TextButton") then
            local n = btn.Name:lower()
            local t = (btn:IsA("TextButton") and btn.Text or ""):lower()
            if n == "server" or n == "servers" or n == "serverbrowser" or n == "server_browser" 
               or n:find("serverbutton") or n:find("server_button") or n:find("serverlist")
               or t == "server" or t == "servers" or t:find("server browser") then
                return btn
            end
        end
    end

    -- 2. Tìm theo container Top / TopRight / Header / Navigation
    for _, item in ipairs(pg:GetDescendants()) do
        local pName = (item.Parent and item.Parent.Name or ""):lower()
        if (pName:find("top") or pName:find("right") or pName:find("header") or pName:find("navbar")) 
            and (item:IsA("ImageButton") or item:IsA("TextButton")) and item.Visible ~= false then
            local n = item.Name:lower()
            if n:find("server") or n:find("browser") or n:find("hop") or n:find("tab") then
                return item
            end
        end
    end

    -- 3. Tìm nút ImageButton ở góc trên bên phải màn hình (icon 2 cửa sổ Server Browser trong Blox Fruits Sea 2 & 3)
    for _, btn in ipairs(pg:GetDescendants()) do
        if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible ~= false then
            local pos = btn.AbsolutePosition
            local sz = btn.AbsoluteSize
            -- Góc trên bên phải: X >= viewSize.X - 160, Y <= 120, kích thước nút hợp lý từ 20 đến 100px
            if pos.X >= (viewSize.X - 160) and pos.Y <= 120 and sz.X >= 20 and sz.X <= 100 and sz.Y >= 20 and sz.Y <= 100 then
                if not btn:FindFirstAncestorOfClass("CoreGui") and not btn.Name:lower():find("chat") then
                    return btn
                end
            end
        end
    end

    -- 4. Tìm trên thanh menu bên trái (cạnh Home/Settings)
    for _, btn in ipairs(pg:GetDescendants()) do
        if (btn:IsA("ImageButton") or btn:IsA("TextButton")) and btn.Visible ~= false then
            local pos = btn.AbsolutePosition
            local sz = btn.AbsoluteSize
            if pos.X <= 160 and pos.Y <= 300 and sz.X >= 20 and sz.X <= 100 and sz.Y >= 20 and sz.Y <= 100 then
                local n = btn.Name:lower()
                if n:find("server") or n:find("browser") then
                    return btn
                end
            end
        end
    end

    return nil
end

