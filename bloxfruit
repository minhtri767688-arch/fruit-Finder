-- Hàm click nút GUI cực mạnh (kết hợp cả firesignal, getconnections, VirtualInputManager, VirtualUser, Activate)
local function clickButtonReliably(btn)
    if not btn then return false end

    -- 1. Cuộn nút vào tầm nhìn của ScrollingFrame (nếu nằm trong container cuộn)
    pcall(function()
        local sf = btn:FindFirstAncestorOfClass("ScrollingFrame")
        if sf and btn.AbsolutePosition and sf.AbsolutePosition then
            local diff = btn.AbsolutePosition.Y - sf.AbsolutePosition.Y
            if diff < 0 or diff > sf.AbsoluteSize.Y then
                sf.CanvasPosition = Vector2.new(0, math.max(0, sf.CanvasPosition.Y + diff - 40))
            end
        end
    end)
    task.wait(0.04)

    local pos = Vector2.zero
    pcall(function()
        if btn.AbsolutePosition and btn.AbsoluteSize then
            pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
        end
    end)

    -- 2. firesignal độc lập từng sự kiện
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        pcall(function() firesignal(btn.MouseButton1Down) end)
        pcall(function() firesignal(btn.MouseButton1Up) end)
    end

    -- 3. getconnections độc lập từng sự kiện
    if getconnections then
        for _, ev in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
            pcall(function()
                local ok, conns = pcall(getconnections, btn[ev])
                if ok and conns then
                    for _, c in ipairs(conns) do
                        pcall(function() c:Fire() end)
                    end
                end
            end)
        end
    end

    -- 4. VirtualInputManager (Mô phỏng click chuột phần cứng)
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim and pos.X > 0 and pos.Y > 0 then
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
            task.wait(0.02)
            vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
        end
    end)

    -- 5. VirtualUser (Mô phỏng click cho cả mobile/mac executors)
    pcall(function()
        local vu = game:GetService("VirtualUser")
        if vu and pos.X > 0 and pos.Y > 0 then
            vu:ClickButton1(pos)
        end
    end)

    -- 6. btn:Activate()
    pcall(function() btn:Activate() end)

    return true
end

