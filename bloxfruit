            end
        end

        -- Đã nhặt và cất hết trái trong server -> Dọn dẹp trạng thái trước khi hop
        shouldTween = false
        getgenv().OnFarm = false
        restoreCharacterMovement()
        clearAllFruitESPs()

        print("[BloxFruits AutoFruit] ✅ Đã nhặt và cất kho toàn bộ trái trong server! Đang hop server mới...")
        setHUDFruit(nil)
        setHUDStatus("hopping server")
        executeServerHop()
    else
        -- SERVER KHÔNG CÓ TRÁI NÀO SAU 5 GIÂY QUÉT KỸ -> TỰ ĐỘNG HOP SERVER
        shouldTween = false
        getgenv().OnFarm = false
        restoreCharacterMovement()
        clearAllFruitESPs()

        print("[BloxFruits AutoFruit] ⚠️ Đã quét kỹ lưỡng toàn bộ map trong 5s nhưng không có trái nào! Đang tự động hop server...")
        setHUDFruit(nil)
        setHUDStatus("hopping server")
        executeServerHop()
    end
