-- 4. Teleport theo JobId (kết hợp cả __ServerBrowser Remote lẫn TeleportService)
local function teleportToJobId(id, playing, maxP)
    -- LỚP BẢO VỆ CỨNG TUYỆT ĐỐI: CHẶN TẤT CẢ SERVER KHÔNG RÕ SỐ NGƯỜI HOẶC >= 10 NGƯỜI HOẶC < 1 NGƯỜI!
    if not playing or playing < CONFIG.MinPlayers or playing > CONFIG.MaxPlayers or playing >= 10 then
        print(string.format("[AutoHop] CHẶN KẾT NỐI: Server %s có %s người (Chỉ được phép từ 1 đến 9 người, BẮT BUỘC DƯỚI 10 NGƯỜI)!", tostring(id):sub(1, 8), tostring(playing)))
        return false
    end

    HopCache[id] = tick()

    pcall(function()
        local q = (syn and syn.queue_on_teleport) or queue_on_teleport or (fluxus and fluxus.queue_on_teleport)
        if q then
            if isfile and isfile("lua") then
                q('task.wait(2); loadfile("lua")()')
            elseif isfile and isfile("bloxfruitautofruit.lua") then
                q('task.wait(2); loadfile("bloxfruitautofruit.lua")()')
            elseif isfile and isfile("bloxfruit.lua") then
                q('task.wait(2); loadfile("bloxfruit.lua")()')
            end
        end
    end)

    -- Cách A: Gọi trực tiếp Remote của Blox Fruits
    pcall(function()
        local sb = ReplicatedStorage:FindFirstChild("__ServerBrowser")
        if sb then
            sb:InvokeServer("teleport", id)
        end
    end)

    -- Cách B: Gọi TeleportService
    pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceID, id, LocalPlayer)
    end)

    -- Watchdog 1.2s: nếu hiện 772 / 773, lập tức bấm OK và trả về false để chuyển server khác ngay
    for _ = 1, 8 do
        task.wait(0.15)
        if dismissRobloxErrorPrompt() then
            print("[AutoHop] Server " .. tostring(id):sub(1, 10) .. " bị lỗi 772/Full! Đã bấm OK, chuyển server ngay!")
            return false
        end
    end

    return true
end

-- Hàm thực thi Server Hop siêu tốc (API 4-9 người trước -> Remote -> Real Browser)
local function executeServerHop()
    setHUDStatus("hopping server")
    setHUDFruit(nil)

    local hopRound = 0
    while true do
        hopRound = hopRound + 1
        print(string.format("[AutoHop] Bắt đầu vòng hop server #%d (Tìm kiếm server %d - %d người, tránh hacker)...", hopRound, CONFIG.MinPlayers, CONFIG.MaxPlayers))

        -- ƯU TIÊN 1: LẤY QUA ROBLOX PUBLIC API (SIÊU TỐC < 0.3s, chuẩn số người 4-9)
        local apiCandidates = getServersViaAPISilent()
        if apiCandidates and #apiCandidates > 0 then
            table.sort(apiCandidates, function(a, b) return a.playing < b.playing end)
            print(string.format("[AutoHop] ⚡ API trả về %d server (%d-%d người). Bắt đầu kết nối server tốt nhất...", #apiCandidates, CONFIG.MinPlayers, CONFIG.MaxPlayers))
            for i = 1, math.min(#apiCandidates, 5) do
                local srv = apiCandidates[i]
                print(string.format("[AutoHop] Đang hop vào server %s (%d/%d người)...", tostring(srv.id):sub(1, 8), srv.playing, srv.maxP))
                local ok = teleportToJobId(srv.id, srv.playing, srv.maxP)
                if not ok then
                    dismissRobloxErrorPrompt()
                end
            end
        end

        -- ƯU TIÊN 2: QUÉT REMOTE __ServerBrowser (nếu API chưa vào được)
        local remoteCandidates = getServersViaRemoteSilent()
        if remoteCandidates and #remoteCandidates > 0 then
            table.sort(remoteCandidates, function(a, b) return a.playing < b.playing end)
            print(string.format("[AutoHop] ⚡ Remote trả về %d server (%d-%d người). Đang kết nối...", #remoteCandidates, CONFIG.MinPlayers, CONFIG.MaxPlayers))
            for i = 1, math.min(#remoteCandidates, 4) do
                local srv = remoteCandidates[i]
                local ok = teleportToJobId(srv.id, srv.playing, srv.maxP)
                if not ok then
                    dismissRobloxErrorPrompt()
                end
            end
        end

        -- ƯU TIÊN 3: Mở Real Server Browser trên màn hình và spam click nút Join
        local browserOk = spamJoinRealBrowser()
        if browserOk then
            task.wait(1.0)
            dismissRobloxErrorPrompt()
        end

        HopCache = { [game.JobId] = tick() }
        getgenv().BFHopCache = HopCache
        task.wait(CONFIG.HopInterval)
        dismissRobloxErrorPrompt()
    end
end

