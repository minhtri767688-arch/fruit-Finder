local function getdis(a, b)
    local char = LocalPlayer.Character
    local hrp = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
    local _b = b or (hrp and hrp.CFrame or CFrame.new(0, 0, 0))
    local posA = Convert_CFrame(a)
    local posB = Convert_CFrame(_b)
    if not posA or not posB then return 9e9 end
    local _a = CFrame.new(posA.X, posB.Y, posA.Z)
    local _b2 = CFrame.new(posB.X, posB.Y, posB.Z)
