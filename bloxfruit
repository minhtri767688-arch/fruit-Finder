-- ====================================================================
-- 🚨 HỆ THỐNG TỰ ĐỘNG BẤM "OK" KHI BỊ LỖI ROBLOX (ERROR 772, 773, TELEPORT FAILED)
-- Tự động bấm OK ngay lập tức khi xuất hiện popup "Server is full (772)"
-- ====================================================================
local function dismissRobloxErrorPrompt()
    local didDismiss = false

    -- 1. GuiService:ClearError()
    pcall(function()
        if GuiService and GuiService.ClearError then
            GuiService:ClearError()
        end
    end)

    -- 2. Quét CoreGui.RobloxPromptGui.promptOverlay
    pcall(function()
        local robloxPromptGui = CoreGui:FindFirstChild("RobloxPromptGui")
        if not robloxPromptGui then return end
        local promptOverlay = robloxPromptGui:FindFirstChild("promptOverlay")
        if not promptOverlay then return end

        local children = promptOverlay:GetChildren()
        if #children == 0 then return end -- Tối ưu: Không có popup thì thoát ngay lập tức, 0% CPU!

        for _, prompt in ipairs(children) do
            for _, btn in ipairs(prompt:GetDescendants()) do
                if btn:IsA("TextButton") or btn:IsA("ImageButton") then
                    local txt = (btn:IsA("TextButton") and btn.Text or ""):lower()
                    local name = btn.Name:lower()

                    -- Bấm nút OK / Confirm / Button / Leave
                    if txt:find("ok") or name:find("ok") or name:find("confirm") or name:find("button") or txt:find("leave") or #prompt:GetChildren() <= 3 then
                        -- Method A: firesignal
                        if firesignal then
                            pcall(function() firesignal(btn.MouseButton1Click) end)
                            pcall(function() firesignal(btn.MouseButton1Down) end)
                            pcall(function() firesignal(btn.MouseButton1Up) end)
                            pcall(function() firesignal(btn.Activated) end)
                        end

                        -- Method B: getconnections
                        if getconnections then
                            for _, ev in ipairs({"MouseButton1Click", "Activated", "MouseButton1Down", "MouseButton1Up"}) do
                                local ok, conns = pcall(getconnections, btn[ev])
                                if ok and conns then
                                    for _, c in ipairs(conns) do pcall(function() c:Fire() end) end
                                end
                            end
                        end

                        -- Method C: VirtualInputManager (click chuột ảo)
                        pcall(function()
                            local vim = game:GetService("VirtualInputManager")
                            if vim and btn.AbsolutePosition and btn.AbsoluteSize then
                                local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
                                vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1)
                                vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1)
                            end
                        end)

                        -- Method D: Activate trực tiếp
                        pcall(function() btn:Activate() end)

                        didDismiss = true
                    end
                end
            end
        end
    end)

    return didDismiss
end

