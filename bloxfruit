-- Hàm lấy chính xác số người chơi của DUY NHẤT một hàng server (không quét lẫn sang hàng khác)
local function getRowPlayerCount(btn)
    if not btn then return 0 end

    -- Tìm Frame đại diện cho đúng hàng chứa nút Join này
    local row = btn.Parent
    local cur = btn
    while cur and cur.Parent do
        local p = cur.Parent
        if p:IsA("ScrollingFrame") or p:FindFirstChildOfClass("UIListLayout") or p:FindFirstChildOfClass("UIGridLayout") then
            row = cur
            break
        end
        if p:IsA("ScreenGui") or p.Name == "PlayerGui" then
            break
        end
        cur = p
    end

    if not row then return 0 end

    -- Quét TextLabel CHỈ nằm trong row này
    for _, lbl in ipairs(row:GetDescendants()) do
        if lbl:IsA("TextLabel") and lbl.Text and lbl.Text ~= "" then
            local t = lbl.Text:gsub("%s+", " ")
            -- 1. Tìm mẫu "X/12" hoặc "X / 12" (VD: "4/12", "7 / 12", "11/12")
            local curP, mxP = t:match("(%d+)%s*/%s*(%d+)")
            if curP and mxP then
                local cNum = tonumber(curP)
                local mNum = tonumber(mxP)
                if mNum and mNum >= 10 and mNum <= 16 and cNum and cNum >= 0 and cNum <= mNum then
                    return cNum
                end
            end

            -- 2. Tìm mẫu "X Players" hoặc "Players: X" hoặc "Count: X"
            local pOnly = t:match("(%d+)%s*Players") or t:match("Players:%s*(%d+)") or t:match("Count:%s*(%d+)")
            if pOnly then
                local cNum = tonumber(pOnly)
                if cNum and cNum >= 0 and cNum <= 16 then
                    return cNum
                end
            end
        end
    end

    return 0
end

