-- QUÉT TOÀN BỘ SERVER VÀ ALL MAP THÔNG MINH, CHẮC CHẮN 100% KHÔNG SÓT BẤT KỲ TRÁI NÀO
local function scanAllFruits()
    local fruits = {}
    local added = {}

    local function checkAndAdd(obj)
        if not obj or added[obj] or ProcessedFruits[obj] then return end
        if isFruitObject(obj) then
            local root = getFruitRoot(obj)
            if root and root:IsA("BasePart") then
                added[obj] = true
                local info = identifyFruit(obj)
                local fruitEntry = {
                    Object = obj,
                    RootPart = root,
                    Info = info,
                    Name = info.DisplayName,
                    Rarity = info.Rarity,
                }
                table.insert(fruits, fruitEntry)
                -- Kích hoạt ngay ESP & Highlight khi phát hiện thấy trái
                createOrUpdateFruitESP(fruitEntry)
            end
        end
    end

    -- 1. Quét toàn bộ con trực tiếp của Workspace (nơi trái thường tự nhiên spawn dưới các gốc cây)
    for _, child in ipairs(Workspace:GetChildren()) do
        if not IgnoredFolders[child.Name] then
            checkAndAdd(child)
            -- Quét sâu cấp 2 & 3 vào các folder / model con trong Workspace (Đảo, công trình, cụm cây...)
            if (child:IsA("Folder") or child:IsA("Model")) and not child:FindFirstChildOfClass("Humanoid") then
                for _, sub in ipairs(child:GetChildren()) do
                    checkAndAdd(sub)
                    if (sub:IsA("Folder") or sub:IsA("Model")) and not sub:FindFirstChildOfClass("Humanoid") then
                        for _, sub2 in ipairs(sub:GetChildren()) do
                            checkAndAdd(sub2)
                        end
                    end
                end
            end
        end
    end

    -- 2. Quét sâu vào các thư mục chứa trái thường gặp trong game
    for _, folderName in ipairs({"Fruit", "Drops", "Fruits", "Chest", "SpawnedFruits", "Debris", "Misc", "Flora", "Trees", "Spawns"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            for _, child in ipairs(folder:GetChildren()) do
                checkAndAdd(child)
            end
        end
    end

    -- 3. Quét mở rộng toàn bộ Map và các hòn đảo (Whole Map & Every Island)
    pcall(function()
        local map = Workspace:FindFirstChild("Map")
        if map then
            for _, island in ipairs(map:GetChildren()) do
                if not IgnoredFolders[island.Name] then
                    for _, sub in ipairs(island:GetChildren()) do
                        checkAndAdd(sub)
                        if sub:IsA("Model") or sub:IsA("Folder") then
                            for _, sub2 in ipairs(sub:GetChildren()) do
                                checkAndAdd(sub2)
                            end
                        end
                    end
                end
            end
        end
    end)


    -- 4. Quét tìm tất cả Tool có EatRemote trong Workspace (Bảo đảm quét sạch 100% dù trái nằm ở bất kỳ đâu)
    pcall(function()
        for _, desc in ipairs(Workspace:GetChildren()) do
            if desc:IsA("Tool") and desc:FindFirstChild("EatRemote", true) then
                checkAndAdd(desc)
            end
        end
    end)

    return sortFruitsByRarity(fruits)
end

local function getFruitRank(fruit)
    if not fruit then return 0 end
    local info = fruit.Info
    local rarity = (info and info.Rarity) or fruit.Rarity
    local name = string.lower((info and info.DisplayName) or fruit.Name or "")
    if string.find(name, "devil fruit") or rarity == "Unknown" then
        return 4.5
    end
    return (rarity and RarityRanks[rarity]) or 0
end

-- Hàm sắp xếp ưu tiên trái hiếm hơn (Mythical > Unknown/Devil Fruit > Legendary > Rare > Uncommon > Common)
sortFruitsByRarity = function(fruits)
    if not fruits or #fruits <= 1 then return fruits end
    table.sort(fruits, function(a, b)
        local rankA = getFruitRank(a)
        local rankB = getFruitRank(b)
        if rankA ~= rankB then
            return rankA > rankB -- Trái hiếm hơn (rank cao hơn) được ưu tiên nhặt trước
        end
        local hrpPos = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or Vector3.zero
        local posA = (a.RootPart and a.RootPart.Position) or (a.Object and a.Object:IsA("Model") and a.Object:GetPivot().Position) or Vector3.zero
        local posB = (b.RootPart and b.RootPart.Position) or (b.Object and b.Object:IsA("Model") and b.Object:GetPivot().Position) or Vector3.zero
        return (posA - hrpPos).Magnitude < (posB - hrpPos).Magnitude
    end)
    return fruits
end

