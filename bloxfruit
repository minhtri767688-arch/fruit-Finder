-- 🌟 HỆ THỐNG ESP & HIGHLIGHT FRUIT (TÊN TRÁI + KHOẢNG CÁCH MÉT + HIGHLIGHT XUYÊN VẬT CẢN)
-- Ví dụ: Kitsune Fruit [ 120m ] (Màu đỏ Red) + Highlight toàn bộ trái
-- ====================================================================
local ActiveFruitESPs = {}

local function getFruitESPColor(fruit)
    local rarity = fruit.Rarity or (fruit.Info and fruit.Info.Rarity) or "Unknown"
    local name = string.lower(fruit.Name or "")
    if string.find(name, "kitsune") or rarity == "Mythical" then
        return Color3.fromRGB(255, 30, 30) -- Màu đỏ rực cho Kitsune / Mythical (chuẩn yêu cầu)
    elseif rarity == "Unknown" or string.find(name, "devil fruit") then
        return Color3.fromRGB(255, 60, 60) -- Màu đỏ cam cho Devil Fruit / Unknown
    elseif rarity == "Legendary" then
        return Color3.fromRGB(190, 60, 255) -- Màu tím Legendary
    elseif rarity == "Rare" then
        return Color3.fromRGB(30, 160, 255) -- Màu xanh lam Rare
    elseif rarity == "Uncommon" then
        return Color3.fromRGB(50, 255, 80) -- Màu xanh lá Uncommon
    else
        return Color3.fromRGB(230, 230, 230) -- Màu trắng xám Common
    end
end

local function removeFruitESP(fruitObj)
    if not fruitObj then return end
    pcall(function()
        if ActiveFruitESPs[fruitObj] then
            local espData = ActiveFruitESPs[fruitObj]
            if espData.Highlight and espData.Highlight.Parent then espData.Highlight:Destroy() end
            if espData.Billboard and espData.Billboard.Parent then espData.Billboard:Destroy() end
            ActiveFruitESPs[fruitObj] = nil
        end
        local oldHl = fruitObj:FindFirstChild("Fruit_ESP_Highlight")
        if oldHl then oldHl:Destroy() end
        local root = fruitObj:FindFirstChild("Handle") or (fruitObj:IsA("BasePart") and fruitObj) or fruitObj.PrimaryPart
        if root then
            local oldBb = root:FindFirstChild("Fruit_ESP_Billboard")
            if oldBb then oldBb:Destroy() end
        end
    end)
end

local function clearAllFruitESPs()
    for obj, _ in pairs(ActiveFruitESPs) do
        removeFruitESP(obj)
    end
    table.clear(ActiveFruitESPs)
end

local function createOrUpdateFruitESP(fruit)
    if not fruit or not fruit.Object or not fruit.Object.Parent then return end
    local root = fruit.RootPart or getFruitRoot(fruit.Object)
    if not root or not root:IsA("BasePart") then return end

    local color = getFruitESPColor(fruit)
    local espData = ActiveFruitESPs[fruit.Object]

    pcall(function()
        if not espData then
            -- 1. Tạo Highlight toàn bộ vật thể trái (nhìn thấy xuyên núi/tường)
            local hl = fruit.Object:FindFirstChild("Fruit_ESP_Highlight")
            if not hl then
                hl = Instance.new("Highlight")
                hl.Name = "Fruit_ESP_Highlight"
                hl.Adornee = fruit.Object
                hl.FillColor = color
                hl.OutlineColor = color
                hl.FillTransparency = 0.45
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = fruit.Object
            else
                hl.FillColor = color
                hl.OutlineColor = color
            end

            -- 2. Tạo BillboardGui hiển thị tên và khoảng cách mét
            local bb = root:FindFirstChild("Fruit_ESP_Billboard")
            local label = nil
            if not bb then
                bb = Instance.new("BillboardGui")
                bb.Name = "Fruit_ESP_Billboard"
                bb.Adornee = root
                bb.Size = UDim2.new(0, 240, 0, 45)
                bb.StudsOffset = Vector3.new(0, 3, 0)
                bb.AlwaysOnTop = true
                bb.MaxDistance = 50000

                label = Instance.new("TextLabel")
                label.Name = "FruitText"
                label.Size = UDim2.new(1, 0, 1, 0)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.TextSize = 14
                label.TextColor3 = color
                label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                label.TextStrokeTransparency = 0.15
                label.Parent = bb
                bb.Parent = root
            else
                label = bb:FindFirstChild("FruitText")
            end

            ActiveFruitESPs[fruit.Object] = {
                Highlight = hl,
                Billboard = bb,
                Label = label,
                Fruit = fruit,
                Root = root,
                Color = color
            }
            espData = ActiveFruitESPs[fruit.Object]
        end

        -- Cập nhật khoảng cách mét thời gian thực
        if espData and espData.Label and espData.Root and espData.Root.Parent then
            local char = LocalPlayer.Character
            local hrp = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
            local dist = hrp and (hrp.Position - espData.Root.Position).Magnitude or 0
            local meters = math.floor(dist / 3)
            local rawName = string.lower(tostring(fruit.Name or "Fruit"))
            local displayESP = (rawName == "unknown" or rawName == "devil fruit" or rawName == "fruit" or rawName == "fruit ") and "unknown fruit" or (rawName:find("fruit") and rawName or (rawName .. " fruit"))
            espData.Label.Text = string.format("%s [ %dm ]", displayESP, meters)
            espData.Label.TextColor3 = espData.Color
        end
    end)
end

