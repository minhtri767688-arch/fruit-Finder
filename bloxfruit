local function _tp(target)
    local gg = Convert_CFrame(target)
    if not gg then return end

    -- An toàn biển: Luôn giữ Y tối thiểu >= 18 studs chống chìm biển
    if gg.Y < 18 then
        gg = CFrame.new(gg.X, 18, gg.Z)
    end

    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart

    -- 1. Nếu cần bypass teleport sang đảo xa (> 2500 studs):
    if CanBypassTeleport(gg) then
        BypassTP(gg)
        task.wait(0.8)
        char = plr.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        root = char.HumanoidRootPart
    end

    char = plr.Character or char
    root = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
    if not root then return end

    local dist = (gg.Position - root.Position).Magnitude
    if dist <= Settings.CollectDistance then
        root.CFrame = gg
        return true
    end

    shouldTween = true

    if not root:FindFirstChild("BodyClip") then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "BodyClip"
        bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = root
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.PlatformStand = true
        if hum.Sit then hum.Sit = false end
    end

    if currentTween then pcall(function() currentTween:Cancel() end) end

    -- Hàm thực hiện bay mượt mà đến 1 điểm
    local function flyToPoint(targetCF)
        if not shouldTween or not targetCF then return end
        local cChar = plr.Character
        local cHrp = cChar and (cChar.PrimaryPart or cChar:FindFirstChild("HumanoidRootPart"))
        if not cHrp then return end

        local d = (targetCF.Position - cHrp.Position).Magnitude
        if d <= 5 then
            block.CFrame = targetCF
            cHrp.CFrame = targetCF
            return
        end

        local time = math.clamp(d / Settings.TweenSpeed, 0.15, 28)
        local tweenInfo = TweenInfo.new(time, Enum.EasingStyle.Linear)
        block.CFrame = CFrame.new(cHrp.Position)
        currentTween = TweenService:Create(block, tweenInfo, {CFrame = targetCF})
        currentTween:Play()

        local t0 = tick()
        while shouldTween and currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing do
            task.wait(0.05)
            if not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
                break
            end
            local curH = plr.Character.HumanoidRootPart
            if (targetCF.Position - curH.Position).Magnitude <= Settings.CollectDistance then
                break
            end
            if (tick() - t0) > (time + 2) then
                break
            end
        end

        if currentTween then
            pcall(function() currentTween:Cancel() end)
            currentTween = nil
        end
        block.CFrame = targetCF
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            plr.Character.HumanoidRootPart.CFrame = targetCF
        end
    end

    local horizDist = (Vector3.new(gg.X, 0, gg.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude

    -- 2. BYPASS TP BACK: Nếu đường bay xa (> 100 studs) qua đảo hoặc qua núi:
    -- Nâng độ cao lên tầng trời (cruise altitude) để bay qua mọi tường, núi, công trình.
    -- Triệt tiêu hoàn toàn lỗi server raycast va chạm địa hình và lỗi "tp back to old support"!
    if horizDist > 100 then
        local cruiseY = math.clamp(math.max(root.Position.Y, gg.Y, 260), 260, 360)

        -- Chặng 1: Bay lên độ cao an toàn nếu đang ở thấp
        if root.Position.Y < cruiseY - 20 then
            flyToPoint(CFrame.new(root.Position.X, cruiseY, root.Position.Z))
        end

        -- Chặng 2: Bay ngang trên tầng trời thênh thang không có vật cản
        flyToPoint(CFrame.new(gg.X, cruiseY, gg.Z))

        -- Chặng 3: Hạ cánh xuống đúng vị trí quả (gg + Vector3.new(0, 4, 0))
        flyToPoint(CFrame.new(gg.Position + Vector3.new(0, 4, 0)))
    else
        -- Cự ly gần (<= 100 studs): Bay thẳng tới vị trí trên quả
        flyToPoint(CFrame.new(gg.Position + Vector3.new(0, 4, 0)))
    end

    return currentTween
end

