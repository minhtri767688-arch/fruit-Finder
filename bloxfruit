local function isFruitObject(obj)
    if not obj or not obj.Parent then return false end
    if ProcessedFruits[obj] then return false end

    -- Tuyệt đối không bao giờ nhận diện vật phẩm trong Character của bất kỳ người chơi nào hoặc Backpack
    if obj.Parent:FindFirstChildOfClass("Humanoid") then return false end
    if obj.Parent == LocalPlayer:FindFirstChild("Backpack") then return false end
    if obj.Parent.Parent and obj.Parent.Parent:FindFirstChildOfClass("Humanoid") then return false end

    local name = string.lower(obj.Name)

    -- 1. LOẠI BỎ TOÀN BỘ VẬT PHẨM NẰM TRONG BLACKLIST
    for _, bad in ipairs(BlacklistedTerms) do
        if string.find(name, bad) then return false end
    end

    -- 2. BẮT BUỘC PHẢI CÓ HANDLE (BasePart)
    local handle = obj:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return false end

    -- 3. BẢO VỆ KÍCH THƯỚC: Trái ác quỷ chỉ là vật phẩm nhỏ cầm tay (kích thước 1-4 studs).
    -- Mọi công trình map, bàn thờ nhiệm vụ, đài tế, sàn, bục, tường, tượng có kích thước > 10 studs -> LOẠI BỎ 100%!
    if handle.Size.Magnitude > 10 then return false end

    -- BƯỚC A: NẾU LÀ TOOL (Rơi trên đất trong Workspace)
    if obj:IsA("Tool") then
        -- Có EatRemote đặc trưng chuẩn 100% của mọi trái Blox Fruits
        if obj:FindFirstChild("EatRemote", true) then return true end
        -- Có thuộc tính OriginalName của game (ví dụ: Rocket-Rocket, Kitsune-Kitsune)
        if obj:GetAttribute("OriginalName") or handle:GetAttribute("OriginalName") then return true end
        -- ToolTip là Blox Fruit
        if obj.ToolTip == "Blox Fruit" then return true end
        -- Hoặc tên khớp trực tiếp với 1 trái thật trong FruitDatabase
        for key in pairs(FruitDatabase) do
            if name:find("%f[%a]" .. key .. "%f[%A]") then return true end
        end
    end

    -- BƯỚC B: NẾU LÀ MODEL TRÁI TỰ NHIÊN SPAWN TRÊN ĐẤT (WILD SPAWNED FRUIT DƯỚI GỐC CÂY)
    if obj:IsA("Model") then
        -- Có EatRemote hoặc OriginalName
        if obj:FindFirstChild("EatRemote", true) or obj:GetAttribute("OriginalName") or handle:GetAttribute("OriginalName") then
            return true
        end
        -- Trái tự nhiên spawn tên "Fruit " hoặc "Blox Fruit" hoặc "Devil Fruit" có TouchInterest trên Handle
        if (name == "fruit " or name == "fruit" or name == "blox fruit" or name == "devil fruit") and handle:FindFirstChild("TouchInterest") then
            return true
        end
        -- Model có tên khớp trực tiếp với 1 trái trong FruitDatabase và Handle có TouchInterest
        for key in pairs(FruitDatabase) do
            if name:find("%f[%a]" .. key .. "%f[%A]") and (handle:FindFirstChild("TouchInterest") or obj.Parent == Workspace or (obj.Parent and (obj.Parent.Name == "Fruit" or obj.Parent.Name == "Drops"))) then
                return true
            end
        end
    end

    return false
end

