-- Hàm khôi phục nhân vật về trạng thái di chuyển bình thường (chống đơ/đứng im)
local function restoreCharacterMovement()
    stopNoClip()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hum then
                hum.PlatformStand = false
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
            if hrp then
                for _, item in ipairs(hrp:GetChildren()) do
                    if item:IsA("BodyVelocity") or item:IsA("BodyGyro") or item:IsA("BodyPosition") then
                        item:Destroy()
                    end
                end
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end)
end

-- Hàm bay NoClip an toàn (có khôi phục nhân vật, không bao giờ bị lỗi)
local function safeFlyTo(hrp, targetCFrame, duration)
    startNoClip()
    local success = pcall(function()
        local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = targetCFrame })
        tween:Play()
        tween.Completed:Wait()
    end)
    if not success then
        hrp.CFrame = targetCFrame
        task.wait(0.1)
    end
    stopNoClip()
end

-- Hàm thu thập quả thông minh (Tận dụng Bug Fly 0.35s -> Stop Fly -> Hút Quả)
local function smartTakeAndStoreFruit(fruitData)
    if not fruitData or not fruitData.Object then
        restoreCharacterMovement()
        return false
    end

    local targetPart = fruitData.RootPart or getFruitRoot(fruitData.Object)
    if not targetPart then
        restoreCharacterMovement()
        return false
    end

    local fruitPos = targetPart.Position
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        restoreCharacterMovement()
        return false
    end

    local hrp = char.HumanoidRootPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    local dist = (hrp.Position - fruitPos).Magnitude

    -- ====================================================================
    -- BƯỚC 1: TẬN DỤNG BUG (FLY 0.35s VỀ HƯỚNG QUẢ -> STOP FLY -> HÚT QUẢ)
    -- Thao tác chuẩn: Lao về hướng quả rồi dừng ngay lập tức để hút
    -- ====================================================================
    startNoClip()
    local okTween, tw = pcall(function()
        return TweenService:Create(hrp, TweenInfo.new(0.35, Enum.EasingStyle.Linear), { CFrame = CFrame.new(fruitPos) })
    end)
    if okTween and tw then
        tw:Play()
        task.wait(0.35)
        tw:Cancel() -- Dừng bay tức thì
    end
    stopNoClip()
    restoreCharacterMovement()

    -- Hút quả về phía trước mặt nhân vật & kích hoạt Touch
    for _ = 1, 4 do
        pcall(function()
            if targetPart and targetPart:IsA("BasePart") then
                targetPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -1.5)
                targetPart.AssemblyLinearVelocity = Vector3.zero
                targetPart.AssemblyAngularVelocity = Vector3.zero
            end
            if fruitData.Object:IsA("Tool") and fruitData.Object:FindFirstChild("Handle") then
                fruitData.Object.Handle.CFrame = hrp.CFrame * CFrame.new(0, 0, -1.5)
                fruitData.Object.Handle.AssemblyLinearVelocity = Vector3.zero
            end
        end)

        if firetouchinterest then
            pcall(function()
                firetouchinterest(hrp, targetPart, 0)
            end)
        end

        if fruitData.Object:IsA("Tool") and hum then
            pcall(function()
                hum:EquipTool(fruitData.Object)
            end)
        end
        task.wait(0.05)
    end

    if firetouchinterest then
        pcall(function() firetouchinterest(hrp, targetPart, 1) end)
    end

    task.wait(0.2)
    storeAllInventoryFruits()

    -- Kiểm tra xem quả đã vào túi chưa
    local isCollected = (fruitData.Object.Parent == LocalPlayer.Backpack) or
                        (LocalPlayer.Character and fruitData.Object.Parent == LocalPlayer.Character) or
                        (not fruitData.Object.Parent or fruitData.Object.Parent ~= Workspace)

    if isCollected then
        restoreCharacterMovement()
        return true
    end

    -- ====================================================================
    -- BƯỚC 2: DỰ PHÒNG NẾU BUG CHƯA KỊP NHẬN (BAY TỚI GẦN ĐỂ NHẶT TRỰC TIẾP)
    -- ====================================================================
    if fruitData.Object.Parent == Workspace then
        -- Nếu ở xa đảo khác (> 800 studs): Fast Island TP & Reset
        if dist > 800 then
            local targetIsland, islandDist = getIslandForPosition(fruitPos)
            local islandPos = targetIsland and (targetIsland:IsA("BasePart") and targetIsland.Position or targetIsland:GetPivot().Position) or fruitPos
            local approachPos = islandPos + Vector3.new(0, 50, 0)
            local flyDuration = math.clamp(dist / 400, 0.4, 3.2)

            safeFlyTo(hrp, CFrame.new(approachPos), flyDuration)
            pcall(function() if hum then hum.Health = 0 end end)

            local newChar = LocalPlayer.CharacterAdded:Wait()
            repeat task.wait(0.1) until newChar and newChar:FindFirstChild("HumanoidRootPart") and newChar:FindFirstChildOfClass("Humanoid")
            task.wait(0.5)

            char = newChar
            hrp = newChar.HumanoidRootPart
            hum = newChar:FindFirstChildOfClass("Humanoid")
        end

        -- Bay ngắn tới sát vị trí quả
        if targetPart and targetPart.Parent and fruitData.Object.Parent == Workspace then
            local targetCFrame = CFrame.new(targetPart.Position + Vector3.new(0, 1.5, 0))
            local curDist = (hrp.Position - targetPart.Position).Magnitude
            local flyTime = math.clamp(curDist / 300, 0.2, 3.5)

            safeFlyTo(hrp, targetCFrame, flyTime)
            restoreCharacterMovement()

            for retry = 1, 3 do
                if not fruitData.Object or fruitData.Object.Parent ~= Workspace then break end

                pcall(function()
                    hrp.CFrame = CFrame.new(targetPart.Position)
                    targetPart.CFrame = hrp.CFrame
                end)

                if firetouchinterest then
                    pcall(function() firetouchinterest(hrp, targetPart, 0) end)
                end

                if fruitData.Object:IsA("Tool") and hum then
                    pcall(function() hum:EquipTool(fruitData.Object) end)
                end

                task.wait(0.2)
                storeAllInventoryFruits()
            end
        end
    end

    restoreCharacterMovement()
    local isDone = (not fruitData.Object or not fruitData.Object.Parent or fruitData.Object.Parent ~= Workspace)
    return isDone
end

